## E3, embarquement des tâches : seulement si resolver vide : pkg/resolve/resolve.go, l. 142 à 165 (sha256 du fichier 0b6479becf84da6b)
 142 | func inlineTasks(tasks []tektonv1.PipelineTask, ropt *Opts, remoteResource FetchedResourcesForRun) ([]tektonv1.PipelineTask, error) {
 143 | 	pipelineTasks := []tektonv1.PipelineTask{}
 144 | 	for _, task := range tasks {
 145 | 		if task.TaskRef != nil &&
 146 | 			task.TaskRef.Resolver == "" &&
 147 | 			isTektonAPIVersion(task.TaskRef.APIVersion) &&
 148 | 			string(task.TaskRef.Kind) != "ClusterTask" &&
 149 | 			!slices.Contains(ropt.SkipInlining, task.TaskRef.Name) {
 150 | 			taskResolved, ok := remoteResource.Tasks[task.TaskRef.Name]
 151 | 			if !ok {
 152 | 				return nil, fmt.Errorf("cannot find referenced task %s. if it's a remote task make sure to add it in the annotations", task.TaskRef.Name)
 153 | 			}
 154 | 			tmd := tektonv1.PipelineTaskMetadata{
 155 | 				Annotations: taskResolved.GetObjectMeta().GetAnnotations(),
 156 | 				Labels:      taskResolved.GetObjectMeta().GetLabels(),
 157 | 			}
 158 | 			task.TaskRef = nil
 159 | 			task.TaskSpec = &tektonv1.EmbeddedTask{
 160 | 				TaskSpec: taskResolved.Spec,
 161 | 				Metadata: tmd,
 162 | 			}
 163 | 		}
 164 | 		pipelineTasks = append(pipelineTasks, task)
 165 | 	}

