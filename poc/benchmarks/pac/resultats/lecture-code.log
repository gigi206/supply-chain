 236 | func (v *Provider) Validate(_ context.Context, _ *params.Run, event *info.Event) error {
 237 | 	signature := event.Request.Header.Get(ForgejoSignatureHeader)
 238 | 	if signature == "" {
 239 | 		signature = event.Request.Header.Get(GiteaSignatureHeader)
 240 | 	}
 241 | 	if signature == "" {
 242 | 		return fmt.Errorf("no signature has been detected, for security reason we are not allowing webhooks without a secret")
 243 | 	}
 244 | 
 245 | 	secret := event.Provider.WebhookSecret
 246 | 	if secret == "" {
 247 | 		return fmt.Errorf("no webhook secret has been set, in repository CR or secret")
 248 | 	}
 249 | 
 250 | 	return validateSignature(signature, event.Request.Payload, []byte(secret))
 251 | }
 252 | 
 253 | func validateSignature(signature string, payload, secret []byte) error {
 254 | 	signatureBytes, err := hex.DecodeString(signature)
 255 | 	if err != nil {
 256 | 		return fmt.Errorf("gitea/forgejo webhook signature is not valid hex: %w", err)
 257 | 	}
 258 | 
 259 | 	mac := hmac.New(sha256.New, secret)
 260 | 	mac.Write(payload)
 261 | 	expectedMAC := mac.Sum(nil)
 262 | 
 263 | 	if subtle.ConstantTimeCompare(signatureBytes, expectedMAC) != 1 {
 264 | 		return fmt.Errorf("gitea/forgejo webhook signature validation failed")
 265 | 	}
 266 | 	return nil

