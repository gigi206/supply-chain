# Essai à sec (18/11/2026) : les trois charts que les scripts installent depuis l'hôte (rke2.sh, D1 de la 08b ; cilium.sh).
# Mêmes archives et mêmes valeurs que etape_rendu de rke2.sh (l. 188 à 193), pas les installations réelles ; Cilium d abord (needs).
# Chemins passés par l'environnement par essai.sh (aucun dépôt de charts, aucun réseau).
releases:
- name: cilium
  namespace: kube-system
  chart: {{ requiredEnv "CHART_CILIUM" }}
  values:
  - {{ requiredEnv "VALEURS_CILIUM" }}
  - {{ requiredEnv "VALEURS_CILIUM_RKE2" }}
- name: rke2-coredns
  namespace: kube-system
  chart: {{ requiredEnv "CHART_COREDNS" }}
  needs: [kube-system/cilium]
  values:
  - {{ requiredEnv "VALEURS_COREDNS" }}
- name: rke2-metrics-server
  namespace: kube-system
  chart: {{ requiredEnv "CHART_METRICS" }}
  needs: [kube-system/cilium]
