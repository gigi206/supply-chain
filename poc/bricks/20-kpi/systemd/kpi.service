# Brique 20, étape 4 : KPI dérivés des attestations, signatures vérifiées par openssl (décision « openssl (Recommandé) » du 24/11/2026).
# NON POSÉ. Seule sortie : Zot, en lecture anonyme. Seule écriture : kpi.prom. Aucun secret : quatre clés publiques, vecteur.pub et
# tsa.pem (chaîne du TSA) dans /etc/kpi/cles, relevé des dates dans /etc/kpi/dates-git.tsv ; lecture seule, à reposer après chaque rejeu ou re-signature.
# Même durcissement que entrees-scan.service. JOURNAL (délais des KEV) : écrit par kpi-journal.service, lancé avant ; Wants et non Requires :
# un lecteur en échec ne bloque pas les KPI (lu dans systemd.unit, non mesuré), kpi_exportateur_journal_timestamp_seconds vieillit.
[Unit]
Description=KPI supply-chain dérivés des attestations (brique 20)
After=zot.service kpi-journal.service
Wants=kpi-journal.service

[Service]
Type=oneshot
User=kpi
Group=kpi
SupplementaryGroups=kpi-journal
Environment=REG=192.168.161.13:5000 CA=/etc/base-grype/ca-poc.crt SIGNATURES=verifiees CLES=/etc/kpi/cles RELEVE=/etc/kpi/dates-git.tsv JOURNAL=/var/lib/kpi-journal/lignes
Environment=SORTIE=/etc/fichiers-metriques/kpi.prom "PRODUITS=sample-app sample-app-deb sample-app-rpm"
ExecStart=/usr/local/lib/kpi/metrics_exporter.py
TimeoutStartSec=2min
IPAddressDeny=any
IPAddressAllow=192.168.161.13
NoNewPrivileges=true
CapabilityBoundingSet=
AmbientCapabilities=
ProtectSystem=strict
ReadWritePaths=/etc/fichiers-metriques/kpi.prom
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
RestrictSUIDSGID=true
RestrictNamespaces=true
RestrictRealtime=true
LockPersonality=true
MemoryDenyWriteExecute=true
RestrictAddressFamilies=AF_INET AF_UNIX
SystemCallArchitectures=native
UMask=0022
