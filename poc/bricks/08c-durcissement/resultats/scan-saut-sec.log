# Script du relevé ci-dessus (scan-saut-sec.sh)
#!/usr/bin/env bash
# Relevé à sec du saut d'un passage du scan (lecture seule, un dry-run serveur) ; sortie recopiée dans resultats/scan-saut-sec.log
set -euo pipefail
export KUBECONFIG=$HOME/.kube/supply-chain-poc.yaml
SO=(-i "$HOME/.cache/supply-chain-poc/08/ssh/id_ed25519" -o "UserKnownHostsFile=$HOME/.cache/supply-chain-poc/08/ssh/known_hosts" -o StrictHostKeyChecking=yes -o BatchMode=yes -o ConnectTimeout=10)
K=/tmp/claude-1000/-home-gigi-Documents-git-github-gigi206-supply-chain/3037736d-8910-46aa-8b19-a8862891a6fb/scratchpad/k8s-cron
echo "# Relevé à sec du saut d'un passage du scan, $(date -u +%Y-%m-%dT%H:%M:%SZ), lecture seule (un dry-run serveur, rien d'écrit)"
echo "## version du cluster et source du contrôleur des CronJobs lu (raw.githubusercontent.com/kubernetes/kubernetes/<version>/pkg/controller/cronjob/)"
kubectl version -o json </dev/null | jq -r '"serveur \(.serverVersion.gitVersion)"'
echo "source lu au tag $(cat $K/version)"
(cd $K && sha256sum cronjob_controllerv2.go utils.go)
echo "### cronjob_controllerv2.go, lignes 514-517 (suspension : retour sans requeue, avant tout calcul)"
sed -n 514,517p $K/cronjob_controllerv2.go
echo "### cronjob_controllerv2.go, lignes 528-562 (passage le plus récent, échéance, MissSchedule)"
sed -n 528,562p $K/cronjob_controllerv2.go
echo "### utils.go, lignes 100-123 (mostRecentScheduleTime : earliestTime relevé à now - startingDeadlineSeconds)"
sed -n 100,123p $K/utils.go
echo "### utils.go, lignes 207-223 (nextScheduleTime appelle mostRecentScheduleTime avec l'échéance)"
sed -n 207,223p $K/utils.go
echo "### cronjob_controllerv2.go, lignes 414-420 (modification hors planning : remis en file aussitôt)"
sed -n 414,420p $K/cronjob_controllerv2.go
echo "## CronJob scan-sample-app et ses Jobs"
kubectl get cronjob -n scan scan-sample-app -o json </dev/null | jq -c '{schedule:.spec.schedule,timeZone:.spec.timeZone,deadline:.spec.startingDeadlineSeconds,suspend:.spec.suspend,concurrency:.spec.concurrencyPolicy,succesGardes:.spec.successfulJobsHistoryLimit,echecsGardes:.spec.failedJobsHistoryLimit,activeDeadline:.spec.jobTemplate.spec.activeDeadlineSeconds,last:.status.lastScheduleTime,ok:.status.lastSuccessfulTime,active:(.status.active//[]|length),gen:.metadata.generation}'
kubectl get job -n scan -o json </dev/null | jq -r '.items[] | "\(.metadata.name) \(.metadata.creationTimestamp) réussi=\(.status.succeeded)"'
echo "événements dans scan : $(kubectl get events -n scan -o name </dev/null | wc -l)"
echo "## dry-run serveur de la suspension (au nom de l'administrateur)"
kubectl patch cronjob -n scan scan-sample-app --type=merge -p '{"spec":{"suspend":true}}' --dry-run=server -o json </dev/null | jq -c '{suspend:.spec.suspend,gen:.metadata.generation}'
echo "PolicyViolation dans le cluster : $(kubectl get events -A --field-selector reason=PolicyViolation -o name </dev/null | wc -l)"
echo "## audit de l'API sur sc-confiance : fichiers (étendue de l'historique), patchs de CronJobs et créations de Jobs dans scan"
ssh -n "${SO[@]}" poc@192.168.161.11 'sudo -n ls -l --time-style=+%FT%T /var/lib/rancher/rke2/server/logs/' | awk 'NF>5 {print $6, $7, $5}'
ssh -n "${SO[@]}" poc@192.168.161.11 'sudo -n sh -c "cat \$(ls -1 /var/lib/rancher/rke2/server/logs/audit*.log | LC_ALL=C sort)"' \
  | jq -R -c 'fromjson? | select(.stage=="ResponseComplete" and ((.objectRef.resource=="cronjobs" and .verb=="patch") or (.objectRef.resource=="jobs" and .verb=="create" and .objectRef.namespace=="scan"))) | {t:.requestReceivedTimestamp,v:.verb,r:.objectRef.resource,ns:.objectRef.namespace,n:(.objectRef.name // ""),u:.user.username,c:.responseStatus.code,dry:(.requestURI|test("dryRun"))}'
echo "## Prometheus et Alertmanager sur sc-stockage"
ssh -n "${SO[@]}" poc@192.168.161.13 'curl -fsS http://127.0.0.1:9090/api/v1/rules?type=alert' \
  | jq -c '.data.groups[] | {g:.name,interval:.interval,r:[.rules[]|select(.name|test("^Scan|^BaseGrype"))|{n:.name,state,dur:.duration,q:.query}]} | select(.r|length>0)'
ssh -n "${SO[@]}" poc@192.168.161.13 'curl -fsS -G http://127.0.0.1:9090/api/v1/query --data-urlencode "query={__name__=~\"scan_dernier_referrer_timestamp_seconds|base_grype_construite_timestamp_seconds\"}"' \
  | jq -c '.data.result[] | {m:.metric.__name__,d:.metric.depot,v:(.value[1]|tonumber|todate)}'
echo "alertes actives dans Alertmanager : $(ssh -n "${SO[@]}" poc@192.168.161.13 'curl -fsS http://127.0.0.1:9093/api/v2/alerts' | jq -c '[.[] | .labels.alertname]')"
echo "récepteurs d'Alertmanager (noms et types ; l'adresse est masquée par l'API, http://127.0.0.1:9095/alerte dans poc/bricks/19-observabilite/config/alertmanager.yml) :"
ssh -n "${SO[@]}" poc@192.168.161.13 'curl -fsS http://127.0.0.1:9093/api/v2/status' | jq -r '.config.original' | grep -E '^- name:|^  [a-z_]+_configs:|^  receiver:|^route:' || true
echo "dernières lignes du récepteur local (journal de recepteur-alertes) :"
ssh -n "${SO[@]}" poc@192.168.161.13 'sudo -n journalctl -u recepteur-alertes -o cat -n 3 --no-pager' | jq -R -c 'fromjson? | {statut,alerte,debut}' || true
echo "## ConfigMap porte/porte : seuils de la porte"
kubectl get cm -n porte porte -o json </dev/null | jq -r '.data["policy-scan.yaml"]' | grep -E 'age_max' || true
echo "fin : $(date -u +%Y-%m-%dT%H:%M:%SZ)"

