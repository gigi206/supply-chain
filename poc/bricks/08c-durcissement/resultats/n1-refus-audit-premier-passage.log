# script du relevé
#!/usr/bin/env bash
# Brique 08c, N1 du 07/11 : refus de l'API entre 14:03:00 et 14:07:00 UTC relus dans l'audit (lecture seule), à la place du compte ad hoc
# de PolicyViolation de 14:06:50 UTC (filtre sur .lastTimestamp seul, nul sur les Events de Kyverno 1.19.2 : compte à 0 quoi qu'il arrive).
# Limite : la politique d'audit met les Events en level None ; l'audit montre les requêtes refusées (dry-runs compris), pas les violations
# émises par le scan d'arrière-plan de Kyverno.
set -uo pipefail
export LC_ALL=C
here=~/Documents/git/github/gigi206/supply-chain/poc/bricks/08-trust-plane
cd "$here" || exit 1
DISTRO=rke2 . ./commun.sh
date -u '+relevé du %d/%m/%Y à %H:%M:%S UTC, lecture seule (audit de l API sur sc-confiance)'
echo "## fichiers d'audit : premier horodatage du fichier qui couvre la fenêtre"
sur sc-confiance "sudo sh -c 'for f in \$(ls -1 $D_ETAT/server/logs/audit*.log | LC_ALL=C sort); do printf \"%s \" \"\${f##*/}\"; head -1 \"\$f\" | grep -o \"\\\"stageTimestamp\\\":\\\"[^\\\"]*\" ; done'" </dev/null | sed 's/^/  /'
audit_api 2026-11-07T14:0 </dev/null | jq -c 'select(.stage == "ResponseComplete" and .requestReceivedTimestamp >= "2026-11-07T14:03:00" and .requestReceivedTimestamp < "2026-11-07T14:07:00")' > "$W/n1-audit.jsonl"
echo "## requêtes terminées entre 14:03:00 et 14:07:00 UTC : $(grep -c . "$W/n1-audit.jsonl" || true)"
echo "## codes de réponse"
jq -r '.responseStatus.code' "$W/n1-audit.jsonl" | sort | uniq -c | sed 's/^ */  /'
echo "## réponses 400, 403, 422 et 5xx, refus d'admission et de droits (heure, utilisateur, verbe, ressource, dry-run, code, message) ; 404 et 409 comptés plus haut"
jq -r 'select(.responseStatus.code | IN(400, 403, 422) or . >= 500) | "  \(.requestReceivedTimestamp[11:19]) \(.user.username) \(.verb) \(.objectRef.resource // "-")/\(.objectRef.name // "-")\(if (.requestURI | test("dryRun")) then " (dry-run)" else "" end) \(.responseStatus.code) \(.responseStatus.message // "" | .[0:160])"' "$W/n1-audit.jsonl" | sort
echo "refus d'un webhook de Kyverno (message « denied the request » d'un webhook kyverno) : $(jq -r 'select(.responseStatus.code >= 400) | .responseStatus.message // ""' "$W/n1-audit.jsonl" | grep -c -i 'kyverno' || true)"
echo "refus d'admission, tous webhooks : $(jq -r 'select(.responseStatus.code >= 400) | .responseStatus.message // ""' "$W/n1-audit.jsonl" | grep -c 'denied the request' || true)"
rm -f -- "$W/n1-audit.jsonl"
date -u '+fin %H:%M:%S UTC'
