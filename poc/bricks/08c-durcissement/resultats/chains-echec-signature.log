# ChainsEchecSignature du 06/11 au 07/11 : relevé en lecture seule, accord du propriétaire (« Oui, examine », 07/11/2026)
# Hypothèses écrites le 2026-11-07T17:29:37Z, avant toute requête :
# - la ligne « firing de 2026-11-06T15:34:00Z à 2026-11-07T11:46:00Z, 18 points » de n1-refus-audit.log donne le premier et le dernier point
#   d'une série à pas de 60 s, pas un épisode continu (il en aurait environ 1 200) : deux épisodes courts sont attendus ;
# - H-a : chaque épisode vient du second volet de la règle (série apparue depuis moins de 10 min, « unless … offset 10m »)
#   après un redémarrage des VM ou du contrôleur, sans hausse du compteur d'échecs ;
# - H-b : un épisode vient d'une vraie hausse du compteur d'échecs (increase > 0), à expliquer par ce qui tournait alors.
# Script (copie ci-dessous) : chains-alerte.sh, requêtes Prometheus query_range et journal du récepteur local, rien d'écrit.
    #!/usr/bin/env bash
    # Relevé en lecture seule de ChainsEchecSignature (06/11 12:00 UTC à maintenant) : Prometheus et récepteur local de sc-stockage.
    set -euo pipefail
    K=$HOME/.cache/supply-chain-poc/08/ssh
    SSHO=(-i "$K/id_ed25519" -o UserKnownHostsFile="$K/known_hosts" -o StrictHostKeyChecking=yes -o BatchMode=yes -o ConnectTimeout=10)
    DEB=2026-11-06T12:00:00Z
    FIN=$(date -u +%Y-%m-%dT%H:%M:%SZ)
    plage() { # $1 = PromQL, lu sur l'entrée standard de ssh
      printf %s "$1" | ssh "${SSHO[@]}" poc@192.168.161.13 \
        "curl -fsS -G http://127.0.0.1:9090/api/v1/query_range --data-urlencode query@- --data-urlencode start=$DEB --data-urlencode end=$FIN --data-urlencode step=60"
    }
    suites() { # séries, puis suites de points consécutifs (pas de 60 s) avec valeurs extrêmes
      jq -r '.status as $s | if (.data.result | length) == 0 then "  \($s), 0 série" else .data.result[] |
        (.metric | to_entries | map(select(.key != "__name__")) | map("\(.key)=\(.value)") | join(",")) as $l |
        (reduce .values[] as $p ([]; if length > 0 and ($p[0] - .[-1][-1][0]) == 60 then .[-1] += [$p] else . + [[$p]] end)) |
        "  série {\($l)} : \(length) suite(s)", (.[] | "    de \(.[0][0] | todate) à \(.[-1][0] | todate), \(length) points, valeurs \(map(.[1]) | unique | join(" "))")
      end'
    }
    echo "# relevé du $(date -u +%Y-%m-%dT%H:%M:%SZ), lecture seule, Prometheus de sc-stockage (127.0.0.1:9090), de $DEB à $FIN, pas de 60 s"
    for q in 'ALERTS{alertname="ChainsEchecSignature"}' \
             'watcher_pipelinerun_signing_failures_total' 'watcher_taskrun_signing_failures_total' \
             'increase(watcher_pipelinerun_signing_failures_total[10m]) > 0' 'increase(watcher_taskrun_signing_failures_total[10m]) > 0' \
             'watcher_pipelinerun_signing_failures_total unless watcher_pipelinerun_signing_failures_total offset 10m' \
             'watcher_taskrun_signing_failures_total unless watcher_taskrun_signing_failures_total offset 10m' \
             'up{job="chains"} == 0' 'absent(up{job="chains"})' \
             'watcher_pipelinerun_sign_created_total' 'watcher_taskrun_sign_created_total'; do
      echo "## $q"
      plage "$q" | suites
    done
    echo "## récepteur local (journal de recepteur-alertes depuis le 06/11 12:00 UTC), notifications ChainsEchecSignature"
    ssh -n "${SSHO[@]}" poc@192.168.161.13 "sudo journalctl -u recepteur-alertes -o json --no-pager --since '2026-11-06 12:00:00 UTC'" \
      | jq -r -c 'select(.MESSAGE | type == "string") | (.__REALTIME_TIMESTAMP | tonumber / 1e6 | floor | todate) as $t
          | (.MESSAGE | fromjson? // empty) | select(.alerte == "ChainsEchecSignature") | "  reçu \($t) : \(.statut), début \(.debut), fin \(.fin // "-")"'

