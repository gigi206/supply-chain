    #!/usr/bin/env bash
    # Complément en lecture seule : ChainsMarqueSansSignature (pending le 06/11 à 18:30 UTC), Prometheus de sc-stockage.
    set -euo pipefail
    K=$HOME/.cache/supply-chain-poc/08/ssh
    SSHO=(-i "$K/id_ed25519" -o UserKnownHostsFile="$K/known_hosts" -o StrictHostKeyChecking=yes -o BatchMode=yes -o ConnectTimeout=10)
    DEB=2026-11-06T18:00:00Z FIN=2026-11-06T18:50:00Z
    plage() { printf %s "$1" | ssh "${SSHO[@]}" poc@192.168.161.13 \
      "curl -fsS -G http://127.0.0.1:9090/api/v1/query_range --data-urlencode query@- --data-urlencode start=$DEB --data-urlencode end=$FIN --data-urlencode step=60"; }
    echo "# relevé du $(date -u +%Y-%m-%dT%H:%M:%SZ), de $DEB à $FIN, pas de 60 s, valeurs non nulles seulement"
    for q in 'ALERTS{alertname="ChainsMarqueSansSignature"}' \
      'increase(watcher_pipelinerun_marked_signed_total[10m]) - increase(watcher_pipelinerun_sign_created_total[10m])' \
      'increase(watcher_taskrun_marked_signed_total[10m]) - increase(watcher_taskrun_sign_created_total[10m])' \
      'watcher_pipelinerun_marked_signed_total' 'watcher_pipelinerun_sign_created_total' \
      'watcher_taskrun_marked_signed_total' 'watcher_taskrun_sign_created_total'; do
      echo "## $q"
      plage "$q" | jq -r '.data.result[] | (.metric | del(.__name__, .instance, .job, .otel_scope_name) | tostring) as $l
        | (.values | map(select(.[1] != "0")) | map("\(.[0] | todate | .[11:16])=\(.[1] | tonumber | . * 100 | round / 100)")) as $v
        | "  \($l) : \(if ($v | length) == 0 then "toujours 0" else ($v | join(" ")) end)"'
    done
