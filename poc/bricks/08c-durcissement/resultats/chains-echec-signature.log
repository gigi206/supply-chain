## D. Notifications d'Alertmanager et journal local de sc-stockage (script notif-journal.sh, copie ci-dessous)
    #!/usr/bin/env bash
    # Complément en lecture seule : notifications d'Alertmanager (Prometheus) et journal local de sc-stockage.
    set -euo pipefail
    K=$HOME/.cache/supply-chain-poc/08/ssh
    SSHO=(-i "$K/id_ed25519" -o UserKnownHostsFile="$K/known_hosts" -o StrictHostKeyChecking=yes -o BatchMode=yes -o ConnectTimeout=10)
    echo "# relevé du $(date -u +%Y-%m-%dT%H:%M:%SZ)"
    echo "## alertmanager_notifications_total{integration=\"webhook\"}, du 06/11 15:20 au 07/11 11:30 UTC, pas de 60 s : changements de valeur"
    printf %s 'alertmanager_notifications_total{integration="webhook"}' | ssh "${SSHO[@]}" poc@192.168.161.13 \
      "curl -fsS -G http://127.0.0.1:9090/api/v1/query_range --data-urlencode query@- --data-urlencode start=2026-11-06T15:20:00Z --data-urlencode end=2026-11-07T11:30:00Z --data-urlencode step=60" \
      | jq -r '.data.result[] | .values | reduce .[] as $p ({p: null, o: []}; if .p != $p[1] then {p: $p[1], o: (.o + ["\($p[0] | todate | .[5:16])=\($p[1])"])} else .p = $p[1] end) | "  " + (.o | join(" "))'
    echo "## échecs de notification (somme sur les raisons) au 07/11 11:20 UTC"
    printf %s 'sum(alertmanager_notifications_failed_total{integration="webhook"})' | ssh "${SSHO[@]}" poc@192.168.161.13 \
      "curl -fsS -G http://127.0.0.1:9090/api/v1/query --data-urlencode query@- --data-urlencode time=2026-11-07T11:20:00Z" | jq -r '"  \(.data.result[0].value[1])"'
    echo "## journal local de sc-stockage : démarrages, archives, lignes par heure le 06/11, lignes du récepteur avant le 07/11"
    ssh -n "${SSHO[@]}" poc@192.168.161.13 "sudo journalctl --list-boots --no-pager; sudo journalctl --disk-usage; sudo ls /var/log/journal/*/ | sed 's/^/  /'; \
      systemd-analyze cat-config systemd/journald.conf | grep -v '^#' | grep -v '^\s*\$'; \
      sudo journalctl -b -1 --no-pager -o short-iso --since '2026-11-06 13:00:00 UTC' --until '2026-11-06 20:00:00 UTC' | cut -c1-13 | sort | uniq -c; \
      echo \"lignes de recepteur-alertes au démarrage précédent : \$(sudo journalctl -b -1 -u recepteur-alertes --no-pager -o short-iso | grep -c . )\"; \
      sudo journalctl -b -1 -u recepteur-alertes --no-pager -o short-iso | head -1 | cut -c1-80"
