## 3. Copie du script (scratchpad/p1p2-stockage.sh)
#!/usr/bin/env bash
# Lecture seule de P1 (tête du journal local de sc-stockage) et P2 (plafond annoncé par journald au démarrage 0, version de systemd).
# Une seule session ssh. Aucun MESSAGE affiché hors des lignes de journald contenant « max ». Filtre jeton|token en sortie.
set -uo pipefail
export LC_ALL=C
O8=$HOME/.cache/supply-chain-poc/08
SSHO=(-n -i "$O8/ssh/id_ed25519" -o "UserKnownHostsFile=$O8/ssh/known_hosts" -o StrictHostKeyChecking=yes -o BatchMode=yes -o ConnectTimeout=10)
date -u '+relevé du %d/%m/%Y à %H:%M:%S UTC'
ssh "${SSHO[@]}" poc@192.168.161.13 'sudo sh -c "
echo \"## version de systemd\"; dpkg-query -W systemd
echo \"## fichiers du journal persistant (taille en octets, nom)\"; for f in /var/log/journal/*/*; do echo \"\$(stat -c %s \"\$f\") \$(basename \"\$f\")\"; done
echo \"## journalctl --disk-usage\"; journalctl --disk-usage
echo \"## tête du journal (entrée la plus ancienne : horodatage et numéro de séquence seulement)\"
journalctl -o json --no-pager --output-fields=__REALTIME_TIMESTAMP,__SEQNUM 2>/dev/null | head -1
echo \"## messages de journald contenant max, démarrage 0\"; journalctl -b 0 -t systemd-journald -o short-iso --no-pager | grep -i max
echo \"## messages de journald contenant max, démarrage -1\"; journalctl -b -1 -t systemd-journald -o short-iso --no-pager | grep -i max
echo \"fin\"
"' </dev/null 2>&1 | grep -viE 'jeton|token'
date -u '+fin du relevé %H:%M:%S UTC'
