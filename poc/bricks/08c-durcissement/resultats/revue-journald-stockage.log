    S=/tmp/claude-1000/-home-gigi-Documents-git-github-gigi206-supply-chain/3037736d-8910-46aa-8b19-a8862891a6fb/scratchpad/image-debian
    IMG=$HOME/.cache/supply-chain-poc/08/telechargements/debian/debian-13-generic-amd64-20261026-2643.qcow2
    M=${IMG%.qcow2}.json
    ext() { echo "### $1, lignes $2 à $3"; sed -n "$2,$3p" "$D/$1" | nl -ba -v "$2" -w5 -s'  '; }
    echo "# Revue statique du plafond de journald (brique 08c), commencée le $(date -u '+%d/%m/%Y à %H:%M:%S UTC')"
    echo "# Menée sur « continue », sans validation du propriétaire. Rien lu ni écrit dans le cluster, Zot ou les VM."
    echo "# Sources : dépôt (journaux archivés), image Debian en cache (lecture locale), source amont de systemd."
    echo
    echo "## 1. Version de systemd"
    echo "manifeste de l'image : $(basename "$M"), contrôlé par SHA512SUMS : $(cd "$(dirname "$M")" && grep "$(basename "$M")" SHA512SUMS | sha512sum -c - 2>&1)"
    jq -r '.items[0].data.packages[] | select(.name | test("^(systemd|cloud-init|cloud-initramfs-growroot|cloud-guest-utils)$")) | "  \(.name) \(.version)"' "$M"
    echo "source lu : systemd amont, tag v257.13, fichiers bruts de raw.githubusercontent.com/systemd/systemd/v257.13/ ; correctifs Debian non lus"
    for f in journal-file.c journald-server.c journald.c journal-vacuum.c; do
      case $f in journal-file.c|journal-vacuum.c) p=src/libsystemd/sd-journal/$f ;; *) p=src/journal/$f ;; esac
      echo "  $p  sha256 $(sha256sum "$D/$f" | cut -d' ' -f1)"
    done
    echo "version installée sur les VM : non relue (aucune lecture des VM ici)"
    echo
    echo "## 2. Extraits du source (numéros de ligne du fichier)"
    ext journal-file.c 56 72
    ext journal-file.c 4003 4080
    ext journal-file.c 4242 4246
    ext journal-file.c 4535 4547
    ext journald-server.c 148 191
    ext journald-server.c 376 392
    ext journald-server.c 799 818
    ext journald-server.c 981 991
    ext journald-server.c 1428 1437
    ext journald-server.c 2649 2669
    ext journal-vacuum.c 177 186
    ext journal-vacuum.c 291 317
    echo "### appels de journal_reset_metrics et rechargement"
    grep -n 'journal_reset_metrics' "$D"/journald-server.c "$D"/journald.c "$D"/journal-file.c | sed "s#$D/##"
    echo "occurrences de reload, SIGHUP ou sighup dans journald-server.c et journald.c : $(cat "$D"/journald-server.c "$D"/journald.c | grep -ciE 'reload|sighup' || true)"
    echo
    echo "## 3. Racine de l'image, avant agrandissement (lecture locale de l'image en cache)"
    qemu-img info --output=json "$IMG" | jq -r '"taille virtuelle : \(."virtual-size") octets"'
    mkdir -p "$S"; cd "$S"
    qemu-img dd -f qcow2 -O raw bs=512 count=34 if="$IMG" of=gpt.raw
    python3 -I - gpt.raw <<'PY'
    import struct,sys
    d=open(sys.argv[1],'rb').read()
    h=d[512:1024]; assert h[:8]==b'EFI PART'
    lba,n,sz=struct.unpack('<QII',h[72:88])
    for i in range(n):
        e=d[lba*512+i*sz: lba*512+(i+1)*sz]
        if e[:16]==b'\0'*16: continue
        first,last=struct.unpack('<QQ',e[32:48])
        print("partition %d : secteurs %d à %d, %d octets (%.3f GiB)" % (i+1, first, last, (last-first+1)*512, (last-first+1)*512/2**30))
    PY
    # qemu-img dd compte count depuis le début de l'image, skip compris
    qemu-img dd -f qcow2 -O raw bs=512 skip=262146 count=262148 if="$IMG" of=sb.raw
    python3 -I - sb.raw <<'PY'
    import struct,sys
    s=open(sys.argv[1],'rb').read()
    assert struct.unpack('<H',s[56:58])[0]==0xEF53
    blo,=struct.unpack('<I',s[4:8]); logbs,=struct.unpack('<I',s[24:28]); bhi,=struct.unpack('<I',s[0x150:0x154])
    bs=1024<<logbs; n=blo|(bhi<<32)
    print("ext4 de la partition 1 : %d blocs de %d octets, %d octets (%.3f GiB)" % (n, bs, n*bs, n*bs/2**30))
    print("10 %% de cette taille : %.1f MiB ; un huitième de ces 10 %% : %.1f MiB (bornes hautes : f_blocks de statvfs exclut des métadonnées)" % (n*bs/10/2**20, n*bs/80/2**20))
    PY
    rm -f gpt.raw sb.raw
    echo "cloud-init : $(grep -A2 '^growpart:' "$OLDPWD/poc/bricks/08-trust-plane/cloud-init/user-data.in" 2>/dev/null | tr '\n' ' ')"
