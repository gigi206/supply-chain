  148  
  149  static int cache_space_refresh(Server *s, JournalStorage *storage) {
  150          JournalStorageSpace *space;
  151          JournalMetrics *metrics;
  152          uint64_t vfs_used, vfs_avail, avail;
  153          usec_t ts;
  154          int r;
  155  
  156          assert(s);
  157  
  158          metrics = &storage->metrics;
  159          space = &storage->space;
  160  
  161          ts = now(CLOCK_MONOTONIC);
  162  
  163          if (space->timestamp != 0 && usec_add(space->timestamp, RECHECK_SPACE_USEC) > ts)
  164                  return 0;
  165  
  166          r = server_determine_path_usage(s, storage->path, &vfs_used, &vfs_avail);
  167          if (r < 0)
  168                  return r;
  169  
  170          space->vfs_used = vfs_used;
  171          space->vfs_available = vfs_avail;
  172  
  173          avail = LESS_BY(vfs_avail, metrics->keep_free);
  174  
  175          space->limit = CLAMP(vfs_used + avail, metrics->min_use, metrics->max_use);
  176          space->available = LESS_BY(space->limit, vfs_used);
  177          space->timestamp = ts;
  178          return 1;
  179  }
  180  
  181  static void patch_min_use(JournalStorage *storage) {
  182          assert(storage);
  183  
  184          /* Let's bump the min_use limit to the current usage on disk. We do
  185           * this when starting up and first opening the journal files. This way
  186           * sudden spikes in disk usage will not cause journald to vacuum files
  187           * without bounds. Note that this means that only a restart of journald
  188           * will make it reset this value. */
  189  
  190          storage->metrics.min_use = MAX(storage->metrics.min_use, storage->space.vfs_used);
  191  }
