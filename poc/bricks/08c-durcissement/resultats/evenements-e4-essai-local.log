    #!/usr/bin/env bash
    # lancer.sh : P1 à P12 et la non-régression P10 ; une ligne de bilan par passage
    set -uo pipefail
    export LC_ALL=C   # corrigé à 23:28 UTC : date factice de P4 écrite en français (« lun. »), illisible par date -d
    D=$(cd "$(dirname "$0")" && pwd)
    export ESS_LIB=$1 ESS_BASE=$D/base
    passe() { # nom attendu(OK|KO) code-attendu contrôle version [VAR=valeur…]
      local nom=$1 att=$2 catt=$3 c=$4 v=$5 out code verdict
      shift 5
      out=$(env "$@" "$D/essai.sh" "$c" "$v" 2>&1 </dev/null); code=$?
      verdict=$(grep -o -E '^(OK|KO)   ' <<< "$out" | head -1 | tr -d ' ')
      [ "$c" = h2_releve ] && grep -q 'ko=1' <<< "$out" && verdict=KO
      printf '%s\n' "$out" > "$D/sorties/$nom.out"; cp "$ESS_BASE/appels" "$D/sorties/$nom.appels" 2>/dev/null || true
      local bilan=conforme
      [ "$verdict" = "$att" ] && [ "$code" = "$catt" ] || bilan=ÉCART
      grep -q 'SECRET-NE-PAS-AFFICHER\|faux-mot-de-passe' <<< "$out" && bilan="$bilan, FUITE"
      grep -q 'TRAP CHANGÉ\|ev-loki LAISSÉ' <<< "$out" && bilan="$bilan, RESTE"
      printf '%-34s %-19s %-7s verdict %-2s code %-3s | %s | %s\n' "$nom" "$c" "$v" "${verdict:--}" "$code" "$bilan" \
        "$(grep -E '^(OK|KO)   ' <<< "$out" | head -1 | cut -c1-150)"
    }
    rm -rf "$D/sorties"; mkdir -p "$D/sorties"
    echo "# P1 à P9, P12 sur resolveurs_pod (après)"
    passe P1-loki0-temoin-kube0      OK 0 resolveurs_pod apres ESS_TEMOIN=1 ESS_LOKI_N=0 ESS_KUBE_N=0
    passe P2-loki2                   KO 1 resolveurs_pod apres ESS_TEMOIN=1 ESS_LOKI_N=2 ESS_KUBE_N=0
    passe P3-temoin-jamais-kube0     OK 0 resolveurs_pod apres ESS_TEMOIN=0 ESS_LOKI_N=0 ESS_KUBE_N=0
    passe P3b-temoin-jamais-kube3    KO 1 resolveurs_pod apres ESS_TEMOIN=0 ESS_LOKI_N=0 ESS_KUBE_N=3
    passe P3c-temoin-3e-appel        OK 0 resolveurs_pod apres ESS_TEMOIN=3 ESS_LOKI_N=0 ESS_KUBE_N=0
    passe P4-alloy-redemarre         OK 0 resolveurs_pod apres ESS_ALLOY="$(date -u '+%a %Y-%m-%d %H:%M:%S UTC')" ESS_KUBE_N=0
    passe P4b-alloy-redemarre-kube3  KO 1 resolveurs_pod apres ESS_ALLOY="$(date -u '+%a %Y-%m-%d %H:%M:%S UTC')" ESS_KUBE_N=3
    passe P4c-alloy-change-pendant   OK 0 resolveurs_pod apres ESS_ALLOY2="$(date -u '+%a %Y-%m-%d %H:%M:%S UTC')" ESS_KUBE_N=0
    passe P5-http500-kube0           OK 0 resolveurs_pod apres ESS_HTTP=500 ESS_KUBE_N=0
    passe P5b-http500-kube3          KO 1 resolveurs_pod apres ESS_HTTP=500 ESS_KUBE_N=3
    passe P6-sans-mdp-kube0          OK 0 resolveurs_pod apres ESS_MDP=0 ESS_KUBE_N=0
    passe P7-alloy-illisible         OK 0 resolveurs_pod apres ESS_ALLOY= ESS_KUBE_N=0
    passe P8-kube1-loki0-temoin      KO 1 resolveurs_pod apres ESS_TEMOIN=1 ESS_LOKI_N=0 ESS_KUBE_N=1
    passe P9-tronque                 KO 1 resolveurs_pod apres ESS_TEMOIN=1 ESS_LOKI_N=5000 ESS_KUBE_N=0
    passe P9b-loki2-sans-temoin      KO 1 resolveurs_pod apres ESS_TEMOIN=0 ESS_LOKI_N=2 ESS_KUBE_N=0
    echo "# P10 : Loki injoignable, avant et après, kubectl 0 puis 3"
    for c in resolveurs_pod scan_saut_suspendre reprendre_cronjob reprendre_pv h2_releve cilium; do
      for k in 0 3; do
        if [ "$k" = 0 ]; then a=OK; else a=KO; fi
        if [ "$c" = h2_releve ]; then ca=0; elif [ "$k" = 0 ]; then ca=0; else ca=1; fi
        for v in avant apres; do passe "P10-$c-k$k-$v" "$a" "$ca" "$c" "$v" ESS_HTTP=000 ESS_KUBE_N=$k; done
      done
    done
    echo "# chacun des six jugé par Loki (après) : Loki 0 et témoin, puis Loki 1"
    for c in resolveurs_pod scan_saut_suspendre reprendre_cronjob reprendre_pv h2_releve cilium; do
      if [ "$c" = h2_releve ]; then ca=0; else ca=1; fi
      passe "J-$c-loki0" OK 0 "$c" apres ESS_TEMOIN=1 ESS_LOKI_N=0 ESS_KUBE_N=0
      passe "J-$c-loki1" KO "$ca" "$c" apres ESS_TEMOIN=1 ESS_LOKI_N=1 ESS_KUBE_N=0
    done
