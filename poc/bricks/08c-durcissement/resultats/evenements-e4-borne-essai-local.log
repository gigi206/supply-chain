## banc : essai.sh
    #!/usr/bin/env bash
    # essai.sh <contrôle> <avant|apres> : fragment du script d'origine, avec faux curl, ssh, kubectl et sleep ; scénario dans ESS_*
    set -euo pipefail
    export LC_ALL=C
    D=$(cd "$(dirname "$0")" && pwd)
    c=$1 v=$2
    B=$ESS_BASE; rm -rf "$B"; mkdir -p "$B/s" "$B/p" "$B/w" "$B/t"
    S=$B/s P=$B/p W=$B/w T=$B/t O=$B
    APPELS=$B/appels; : > "$APPELS"
    [ "${ESS_MDP:-1}" = 1 ] && printf 'faux-mot-de-passe\n' > "$S/grafana-auditeur.password"
    declare -A IP=([sc-stockage]=192.0.2.13); SSH_OPTS=()
    ko=0
    t0=$(date -u -d '-30 sec' +%Y-%m-%dT%H:%M:%SZ); t1=$t0
    printf '[{"metadata":{"creationTimestamp":"%s"}},{"metadata":{"creationTimestamp":"%s"}}]\n' "$(date -u +%Y-%m-%dT%H:%M:%SZ)" "$t0" > "$T/pods.json"
    echo 0 > "$B/n-temoin"; echo 0 > "$B/n-ssh"
    
    curl() {
      local o="" d="" a cfg e m de to n i k
      while [ $# -gt 0 ]; do case $1 in -o) o=$2; shift 2 ;; -d) d=$2; shift 2 ;; *) shift ;; esac; done
      cfg=$(cat); case $cfg in 'user = "auditeur:'*) ;; *) echo "curl : configuration inattendue" >&2; return 2 ;; esac
      e=$(jq -r '.queries[0].expr' <<< "$d"); m=$(jq -r '.queries[0].maxLines' <<< "$d"); de=$(jq -r .from <<< "$d"); to=$(jq -r .to <<< "$d")
      if [ "${ESS_HTTP:-200}" = 000 ]; then echo "curl expr=$e (injoignable)" >> "$APPELS"; printf 000; return 7; fi
      if [ "$e" = '{source="evenements-k8s"}' ] && [ "$m" = 1 ]; then
        k=$(( $(cat "$B/n-temoin") + 1 )); echo "$k" > "$B/n-temoin"
        n=$([ "${ESS_TEMOIN:-1}" != 0 ] && [ "$k" -ge "${ESS_TEMOIN:-1}" ] && echo 1 || echo 0)
        echo "curl témoin n°$k de=$de a=$to -> $n" >> "$APPELS"
      else
        n=${ESS_LOKI_N:-0}; [ "$n" -le "$m" ] || n=$m
        echo "curl compte expr=$e de=$de a=$to max=$m -> $n" >> "$APPELS"
      fi
      if [ "${ESS_HTTP:-200}" != 200 ]; then printf '{"message":"x"}' > "$o"; printf '%s' "$ESS_HTTP"; return 0; fi
      jq -nc --argjson n "$n" '{results: {A: {frames: [{data: {values: [[range(0; $n) | {}], [range(0; $n) | 1762732800000 + .], [range(0; $n) | ({kind: "Pod", name: "x", reason: "PolicyViolation", count: 1, msg: "SECRET-NE-PAS-AFFICHER"} | tojson)]]}}]}}}' > "$o"
      printf 200
    }
    ssh() {
      local k; k=$(( $(cat "$B/n-ssh") + 1 )); echo "$k" > "$B/n-ssh"; echo "ssh n°$k" >> "$APPELS"
      if [ "$k" -ge 2 ] && [ -n "${ESS_ALLOY2+x}" ]; then printf '%s\n' "$ESS_ALLOY2"; else printf '%s\n' "${ESS_ALLOY-Sat 2000-01-01 00:00:00 UTC}"; fi
    }
    sleep() { echo "sleep $1" >> "$APPELS"; }
    kubectl() {
      local kind=CronJob name=x reason=Normal a="$*"
      case $a in *kube-system*) kind=Pod name=cilium-abc reason=Pulling ;; *reason=PolicyViolation*) reason=PolicyViolation ;; *reason=FailedCreate*) reason=FailedCreate ;; esac
      echo "kubectl $a" >> "$APPELS"
      # ESS_KUBE_N Events datés de 2099 (dans toute fenêtre), ESS_KUBE_AVANT datés de 2000 (avant toute fenêtre, ajouté à 23:33 UTC)
      jq -nc --argjson n "${ESS_KUBE_N:-0}" --argjson av "${ESS_KUBE_AVANT:-0}" --arg k "$kind" --arg nm "$name" --arg r "$reason" \
        '{items: ([range(0; $n) | "2099-01-01T00:00:00Z"] + [range(0; $av) | "2000-01-01T00:00:00Z"] | map({metadata: {creationTimestamp: .},
          lastTimestamp: ., involvedObject: {kind: $k, name: $nm}, reason: $r}))}'
    }
    case $c in h2_releve) . "$D/def-durcissement.sh" ;; cilium) . "$D/def-cilium.sh" ;; *) . "$D/def-preuves.sh" ;; esac
    [ "$v" = avant ] || . "$ESS_LIB"
    EV_ATTENTE=${ESS_ATTENTE:-120}
    trap_avant=$(trap -p)
    . "$D/$c.$v"
    echo "fin du fragment, ko=$ko"
    [ "$(trap -p)" = "$trap_avant" ] && echo "trap inchangé" || echo "TRAP CHANGÉ"
    [ -e "$W/ev-loki" ] && echo "ev-loki LAISSÉ" || echo "ev-loki absent"
