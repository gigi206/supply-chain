# Essai hors cluster de evenements.sh releve (09/11/2026, 14:45:52 UTC), avant tout passage : rien lu ni écrit dans le cluster, Loki, Grafana ou les VM.
# Copie du script, de commun.sh, de distro.sh et des journaux archivés cités, dans un dépôt git jetable ; env -i, HOME et CONFIANCE_DIR jetables,
# faux mot de passe ; faux curl (réponses de Grafana : lignes, aucune trame, erreur de Loki, HTTP 500, 1000 lignes), faux ssh et faux kubectl
# qui consignent leurs appels. Limites : les réponses de Grafana sont fabriquées sur la forme lue par g1_grafana (07a) et scan-saut-resolution.sh
# (08c), jamais une vraie réponse ; le format des dates de systemd (« Sat 2026-11-07 12:22:01 CET ») est supposé, non relu sur sc-stockage.
# Le chemin du dossier personnel est remplacé par ~.

## essai.sh
#!/usr/bin/env bash
# Harnais hors cluster de evenements.sh releve : copie du script dans un dépôt jetable, faux curl, ssh et kubectl qui consignent leurs appels.
set -uo pipefail
D=${0%/*}
SRC=~/Documents/git/github/gigi206/supply-chain/poc/bricks
avant=$(cd "$SRC/.." && git status --porcelain </dev/null | md5sum; ls "$SRC/08c-durcissement/resultats" | md5sum)
echo "# date : $(date -u +%FT%TZ) ; sha256 de evenements.sh : $(sha256sum "$SRC/08c-durcissement/evenements.sh" | cut -c1-64)"
run() { # nom env…
  local n=$1; shift
  local A=$D/$n; rm -rf "$A"; mkdir -p "$A/repo/poc/bricks/08c-durcissement/resultats" "$A/repo/poc/bricks/08-trust-plane/resultats" "$A/home" "$A/conf/secrets" "$A/conf/pki" "$A/conf/ssh"
  cp "$SRC/08c-durcissement/evenements.sh" "$A/repo/poc/bricks/08c-durcissement/"
  cp "$SRC/08c-durcissement/resultats/durcissement-h2_releve.log" "$A/repo/poc/bricks/08c-durcissement/resultats/"
  cp "$SRC/08-trust-plane/commun.sh" "$SRC/08-trust-plane/distro.sh" "$A/repo/poc/bricks/08-trust-plane/"
  cp "$SRC"/08-trust-plane/resultats/{preuves-h5-resolveurs_pod.log,preuves-h5-scan_saut_suspendre.log,preuves-h5-scan_saut_reprendre.log,rejeu-rke2-sixieme-passage.log} "$A/repo/poc/bricks/08-trust-plane/resultats/"
  git -C "$A/repo" init -q
  printf 'FAUX-MDP' > "$A/conf/secrets/grafana-auditeur.password"; : > "$A/conf/pki/ca-poc.crt"
  ( cd "$A/repo" && env -i PATH="$D/bin:/usr/bin:/bin" HOME="$A/home" CONFIANCE_DIR="$A/conf" ESSAI_LOG="$A/appels" "$@" \
      bash poc/bricks/08c-durcissement/evenements.sh releve > "$A/sortie" 2>&1; echo "code : $?" >> "$A/sortie" )
  echo "## $n ($*)"
  grep -E '^(OK|KO|NJ) |^## (bilan|précondition)|^code|^KO   démarrage' "$A/sortie" | sed 's/^/  /'
  echo "  appels : curl $(grep -c '^curl' "$A/appels" || true), ssh $(grep -c '^ssh' "$A/appels" || true), kubectl $(grep -c '^kubectl' "$A/appels" || true) ; mot de passe en argument : $(grep -c 'mdp_en_argument=True' "$A/appels" || true)"
  echo "  commandes ssh : $(grep '^ssh' "$A/appels" | cut -f2 | sort -u | paste -sd'|')"
  echo "  journal : mot de passe, jeton, token ou msg (« secret ») : $(grep -c -i -E 'FAUX-MDP|jeton|token|secret' "$A/repo/poc/bricks/08c-durcissement/resultats/evenements-releve.log" || true) ; travail restant : $(ls -A "$A/conf/travail" | paste -sd, -)"
}
run normal ESSAI_MODE=normal
run alloy-ancien ESSAI_MODE=normal "ESSAI_ALLOY=Wed 2026-11-04 10:00:00 CET"
run r1-faible ESSAI_MODE=normal ESSAI_R1=10 "ESSAI_ALLOY=Wed 2026-11-04 10:00:00 CET"
run tronque ESSAI_MODE=tronque "ESSAI_ALLOY=Wed 2026-11-04 10:00:00 CET"
run erreur ESSAI_MODE=erreur
run http500 ESSAI_MODE=http500
run temoin-vide ESSAI_MODE=normal ESSAI_TEMOIN=0 "ESSAI_ALLOY=Wed 2026-11-04 10:00:00 CET"
run zeros-faux ESSAI_MODE=tout "ESSAI_ALLOY=Wed 2026-11-04 10:00:00 CET"
run alloy-vide ESSAI_MODE=normal ESSAI_ALLOY=
run lignes-sans-e3 ESSAI_MODE=tout
run lignes-r1-faible ESSAI_MODE=tout ESSAI_R1=10 "ESSAI_ALLOY=Wed 2026-11-04 10:00:00 CET"
apres=$(cd "$SRC/.." && git status --porcelain </dev/null | md5sum; ls "$SRC/08c-durcissement/resultats" | md5sum)
[ "$avant" = "$apres" ] && echo "dépôt : git status et resultats/ inchangés" || echo "dépôt : CHANGÉ"

## faux curl (bin/curl)
#!/usr/bin/env python3
import sys,json,os
a=sys.argv[1:]; out=None; data=None
for i,x in enumerate(a):
    if x=='-o': out=a[i+1]
    if x=='-d': data=a[i+1]
cfg=sys.stdin.read()
log=os.environ['ESSAI_LOG']
q=json.loads(data); e=q['queries'][0]['expr']; de=int(q['from'])//1000; to=int(q['to'])//1000
open(log,'a').write('curl\t%s\t%d\t%d\tmdp_en_argument=%s\n'%(e,de,to, any('FAUX-MDP' in x for x in a)))
mode=os.environ.get('ESSAI_MODE','normal')
import datetime
def ts(s): return int(datetime.datetime.fromisoformat(s.replace('Z','+00:00')).timestamp())
R1=ts('2026-11-06T16:49:02Z'); R6=ts('2026-11-09T09:30:00Z')
n=0
if mode=='http500': print('500',end=''); open(out,'w').write('{}'); sys.exit(0)
if mode=='erreur': json.dump({'results':{'A':{'error':'parse error','status':400}}},open(out,'w')); print('200',end=''); sys.exit(0)
if e=='{source="evenements-k8s"}': n=int(os.environ.get('ESSAI_TEMOIN','5'))
elif 'PolicyViolation' in e and de==R1: n=int(os.environ.get('ESSAI_R1','40'))
elif 'kind="CronJob"' in e and de==R6: n=1
elif mode=='tout' : n=2
if mode=='tronque' and 'PolicyViolation' in e and de==R1: n=1000
lines=[json.dumps({'name':'p%d'%i,'kind':'Pod','reason':'X','msg':'secret token jeton','count':1}) for i in range(n)]
frames=[{'data':{'values':[[{}]*n,[ (de+i)*1000 for i in range(n)],lines]}}] if n else []
json.dump({'results':{'A':{'frames':frames,'status':200}}},open(out,'w')); print('200',end='')

## faux ssh (bin/ssh)
#!/usr/bin/env bash
printf 'ssh\t%s\n' "${*: -1}" >> "$ESSAI_LOG"
case "${*: -1}" in
  *ActiveEnterTimestamp*) echo "${ESSAI_ALLOY-Sat 2026-11-07 12:22:01 CET}" ;;
  *is-active*) echo active ;;
  *) echo "appel inattendu" >&2; exit 9 ;;
esac

## faux kubectl (bin/kubectl)
#!/usr/bin/env bash
printf "kubectl\t%s\n" "$*" >> "$ESSAI_LOG"; exit 9

