   316	func eventTimestamp(event *corev1.Event) time.Time {
   317		if event.Series != nil && !event.Series.LastObservedTime.IsZero() {
   318			return event.Series.LastObservedTime.Time
   319		}
   320		if !event.LastTimestamp.IsZero() {
   321			return event.LastTimestamp.Time
   322		}
   323		return event.EventTime.Time
   324	}
