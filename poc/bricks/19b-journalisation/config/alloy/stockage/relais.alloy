// Brique 19b, L3 (D17) : relais en écriture seule pour sc-confiance (port 3501) et sc-build (port 3502). Chaque port n'accepte
// que les certificats de l'autorité propre à son nœud ; l'étiquette noeud est remplacée ici, quelle que soit celle reçue.
loki.relabel "noeud_confiance" {
  forward_to = []
  rule {
    target_label = "noeud"
    replacement  = "sc-confiance"
  }
}

loki.relabel "noeud_build" {
  forward_to = []
  rule {
    target_label = "noeud"
    replacement  = "sc-build"
  }
}

loki.source.api "confiance" {
  http {
    listen_address = "192.168.161.13"
    listen_port    = 3501
    tls {
      cert_file        = "/etc/alloy/tls/relais.crt"
      key_file         = "/etc/alloy/tls/relais.key"
      client_auth_type = "RequireAndVerifyClientCert"
      client_ca_file   = "/etc/alloy/tls/ca-sc-confiance.crt"
    }
  }
  use_incoming_timestamp = true
  relabel_rules          = loki.relabel.noeud_confiance.rules
  forward_to             = [loki.write.sortie.receiver]
}

loki.source.api "build" {
  http {
    listen_address = "192.168.161.13"
    listen_port    = 3502
    tls {
      cert_file        = "/etc/alloy/tls/relais.crt"
      key_file         = "/etc/alloy/tls/relais.key"
      client_auth_type = "RequireAndVerifyClientCert"
      client_ca_file   = "/etc/alloy/tls/ca-sc-build.crt"
    }
  }
  use_incoming_timestamp = true
  relabel_rules          = loki.relabel.noeud_build.rules
  forward_to             = [loki.write.sortie.receiver]
}
