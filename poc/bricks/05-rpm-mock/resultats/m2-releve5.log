  11: def _subprocess_executor(command):
  12:     """
  13:     We use doOutChroot normally in query_packages* methods, this is a helper
  14:     for testing purposes.
  15:     """
  16:     return subprocess.check_output(command, env={"LC_ALL": "C"}).decode("utf-8")
  17: 
  18: 
  19: def query_packages(fields, chrootpath=None, executor=_subprocess_executor):
  20:     """
  21:     Query the list of installed packages, including FIELDS metadata, from
  22:     CHROOTPATH.
  23: 
  24:     The FIELDS argument is an array of RPM tags from 'rpm --querytags', without
  25:     the '%{}' syntax, for example ['name'] queries for %{name}'.  There's an
  26:     additional non-standard "signature" field parsed from the standard
  27:     "%{sigpgp:pgpsig}" field (the last 8 hex characters).
  28: 
  29:     CHROOTPATH is the chroot directory with RPM DB.  If CHROOTPATH is not
  30:     specified, the method uses the rpmdb from host.
  31: 
  32:     EXECUTOR is a callback accepting a single argument - command that will be
  33:     executed, and its standard output returned as unicode multiline string.
  34: 
  35:     The method returns a list of dictionaries (package metadata info) in a
  36:     format documented on
  37:         https://docs.pagure.org/koji/content_generator_metadata/#buildroots
  38:     For example:
  39: 
  40:     [{
  41:        "license": "LicenseRef-Fedora-Public-Domain",
  42:        "name": "filesystem",
  43:        "version": "3.18",
  44:        "release": "23.fc41",
  45:        "arch": "x86_64",
  46:        "epoch": null,
  47:        "sigmd5": "dc6edb2b7e390e5f0994267d22b9dc1a",
  48:        "signature": null
  49:     }]
  50:     """
  51:     package_list_cmd = ["rpm", "-qa"]
  52:     if chrootpath:
  53:         package_list_cmd += ["--root", chrootpath]
  54:     package_list_cmd.append("--qf")
  55: 
  56:     # HACK: Zero-termination is not possible with 'rpm -q --qf QUERYSTRIG', so
  57:     # this is a hack.  But how likely we can expect the following string in the
  58:     # real packages' metadata?
  59:     separator = '|/@'
  60: 
  61:     def _query_key(key):
  62:         # The Koji Content Generator's "signature" field can be queried via %{sigpgp}
  63:         if key == "signature":
  64:             return "sigpgp:pgpsig"
  65:         return key
  66: 
  67:     query_fields = [_query_key(f) for f in fields]
  68:     package_list_cmd.append(separator.join(f"%{{{x}}}" for x in query_fields) + "\n")
  69: 
  70:     def _fixup(package):
  71:         """ polish the package's metadata output """
  72:         key = "signature"
  73:         if key in package:
  74:             if package[key] == "(none)":
  75:                 package[key] = None
  76:             else:
  77:                 # RSA/SHA256, Mon Jul 29 10:12:32 2024, Key ID 2322d3d94bf0c9db
  78:                 # Get just last 8 chars --->                           ^^^^^^^^
  79:                 package[key] = package[key].split()[-1][-8:]
  80:         key = "epoch"
  81:         if package[key] == "(none)":
  82:             package[key] = None
  83:         return package
  84: 
  85:     return [_fixup(p) for p in [dict(zip(fields, line.split(separator))) for
  86:                                 line in
  87:                                 sorted(executor(package_list_cmd).splitlines())]
  88:             if p["name"] != "gpg-pubkey"]
  89: 
  90: 
  91: def query_packages_location(packages, chrootpath=None,
  92:                             executor=_subprocess_executor, dnf_cmd="/bin/dnf"):
  93:     """
  94:     Detect the URLs of the PACKAGES - array of dictionaries (see the output
  95:     from query_packages()) in available RPM repositories (/etc/yum.repos.d).
  96:     This method modifies PACKAGES in-situ, it adds "url" field to every single
  97:     dictionary in the PACKAGES array.
  98: 
  99:     CHROOTPATH is the chroot directory with RPM DB, if not specified, rpmdb
  100:     from host is used.
  101: 
  102:     EXECUTOR is a callback accepting a single argument - command that will be
  103:     executed, and its standard output returned as unicode multiline string.
  104: 
  105:     Example output:
  106: 
  107:     [{
  108:        "name": "filesystem",
  109:        "version": "3.18",
  110:        ...
  111:        "url": "https://example.com/fedora-repos-rawhide-42-0.1.noarch.rpm",
  112:        ...
  113:     }]
  114:     """
  115: 
  116:     if 'yum' in dnf_cmd:
  117:         # yum (yum-utils must be installed)
  118:         query_locations_cmd = ['/usr/bin/repoquery']
  119:     else:
  120:         # dnf
  121:         query_locations_cmd = [dnf_cmd]
  122:         if chrootpath:
  123:             query_locations_cmd += [f"--installroot={chrootpath}"]
  124:         query_locations_cmd += ["repoquery"]
  125:     # The -q is necessary because of and similar:
  126:     # https://github.com/rpm-software-management/dnf5/issues/1361
  127:     query_locations_cmd += ["-q", "--location"]
  128:     query_locations_cmd += [
  129:         f"{p['name']}-{p['version']}-{p['release']}.{p['arch']}"
  130:         for p in packages
  131:     ]
  132:     location_map = {}
  133:     for url in executor(query_locations_cmd).splitlines():
  134:         basename = os.path.basename(url)
  135:         # name-arch pair should be unique on the box for every installed package
  136:         name, _, _ = basename.rsplit("-", 2)
  137:         arch = basename.split(".")[-2]
  138:         location_map[f"{name}.{arch}"] = url
  139: 
  140:     failed_packages = []
  141:     for package in packages:
  142:         name_arch = f"{package['name']}.{package['arch']}"
  143:         try:
  144:             package["url"] = location_map[name_arch]
  145:         except KeyError:
  146:             failed_packages.append(package)
  147: 
  148:     if failed_packages:
  149:         failed_str = ", ".join([f"{p['name']}-{p['version']}-{p['release']}.{p['arch']}"
  150:                                 for p in failed_packages])
  151:         raise mockbuild.exception.Error(f"Can't get location for {failed_str}")
