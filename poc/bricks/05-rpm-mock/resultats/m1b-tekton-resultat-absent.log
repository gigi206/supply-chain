295: func mismatchedTypesResults(tr *v1.TaskRun, specResults []v1.TaskResult) map[string]string {
296: 	neededTypes := make(map[string]string)
297: 	mismatchedTypes := make(map[string]string)
298: 	var filteredResults []v1.TaskRunResult
299: 	// collect needed types for results
300: 	for _, r := range specResults {
301: 		neededTypes[r.Name] = string(r.Type)
302: 	}
303: 
304: 	// collect mismatched types for results, and correct results in filteredResults
305: 	for _, trr := range tr.Status.Results {
306: 		needed, ok := neededTypes[trr.Name]
307: 		if ok && needed != string(trr.Type) {
308: 			mismatchedTypes[trr.Name] = fmt.Sprintf("task result is expected to be \"%v\" type but was initialized to a different type \"%v\"", needed, trr.Type)
309: 		} else {
310: 			filteredResults = append(filteredResults, trr)
311: 		}
312: 	}
313: 	// remove the mismatched results
314: 	tr.Status.Results = filteredResults
315: 	return mismatchedTypes
316: }

