267: func validateTaskRunResults(tr *v1.TaskRun, resolvedTaskSpec *v1.TaskSpec) error {
268: 	specResults := []v1.TaskResult{}
269: 	if tr.Spec.TaskSpec != nil {
270: 		specResults = append(specResults, tr.Spec.TaskSpec.Results...)
271: 	}
272: 
273: 	if resolvedTaskSpec != nil {
274: 		specResults = append(specResults, resolvedTaskSpec.Results...)
275: 	}
276: 
277: 	// When get the results, check if the type of result is the expected one
278: 	if missmatchedTypes := mismatchedTypesResults(tr, specResults); len(missmatchedTypes) != 0 {
