331: 	// collect provided keys for object results
332: 	for _, trr := range tr.Status.Results {
333: 		if trr.Value.Type == v1.ParamTypeObject {
334: 			for key := range trr.Value.ObjectVal {
335: 				providedKeys[trr.Name] = append(providedKeys[trr.Name], key)
336: 			}
337: 		}
338: 	}
339: 	return findMissingKeys(neededKeys, providedKeys)
340: }

### findMissingKeys (ligne 148)
148: func findMissingKeys(neededKeys, providedKeys map[string][]string) map[string][]string {
149: 	missings := map[string][]string{}
150: 	for p, keys := range providedKeys {
151: 		if _, ok := neededKeys[p]; !ok {
152: 			// Ignore any missing objects - this happens when object param is provided with default
153: 			continue
154: 		}
155: 		missedKeys := list.DiffLeft(neededKeys[p], keys)
156: 		if len(missedKeys) != 0 {
157: 			missings[p] = missedKeys
158: 		}
159: 	}
160: 
161: 	return missings
162: }

