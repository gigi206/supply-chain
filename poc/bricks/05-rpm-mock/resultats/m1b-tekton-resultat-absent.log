440: func (e Entrypointer) readResultsFromDisk(ctx context.Context, resultDir string, resultType result.ResultType) error {
441: 	output := []result.RunResult{}
442: 	results := e.Results
443: 	if resultType == result.StepResultType {
444: 		results = e.StepResults
445: 	}
446: 	for _, resultFile := range results {
447: 		if resultFile == "" {
448: 			continue
449: 		}
450: 		fileContents, err := os.ReadFile(filepath.Join(resultDir, resultFile))
451: 		if os.IsNotExist(err) {
452: 			continue
453: 		} else if err != nil {
454: 			return err
455: 		}
456: 		// if the file doesn't exist, ignore it
457: 		output = append(output, result.RunResult{
458: 			Key:        resultFile,
459: 			Value:      string(fileContents),
460: 			ResultType: resultType,
461: 		})
462: 	}
463: 
464: 	signed, err := signResults(ctx, e.SpireWorkloadAPI, output)
465: 	if err != nil {
466: 		return err
467: 	}
468: 	output = append(output, signed...)
469: 
470: 	// push output to termination path
471: 	if e.ResultExtractionMethod == ResultExtractionMethodTerminationMessage && len(output) != 0 {
472: 		if err := e.writeTerminationMessage(e.TerminationPath, output); err != nil {
473: 			return err
474: 		}
475: 	}
476: 	return nil
477: }

