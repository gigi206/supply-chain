  260:     def execute(self, *args, **kwargs):
  261:         """
  262:         Execute package manger command (via self._execute_mounted where the
  263:         args[] form the command, self.build_invocation).  Make sure the
  264:         essential and the recursive buildroot-in-bootstrap mount points are
  265:         (un)mounted correctly).
  266:         """
  267:         self.plugins.call_hooks("preyum")
  268: 
  269:         # systemd-nspawn v253.9 started to dislike our pre-created essential
  270:         # mountpoints in `-D rootdir`.  Previous versions silently overmounted
  271:         # them (Copr issue#2906).  Note that we still need essential mountpoints
  272:         # if DNF is run with NSPAWN with --installroot (so we do this only if
  273:         # is_bootstrap_image is True).
  274:         skip_essential_mounts = util.USE_NSPAWN and self.is_bootstrap_image
  275: 
  276:         try:
  277:             with self.buildroot.mounts.essential_mounted(noop=skip_essential_mounts):
  278:                 with self.buildroot.mounts.buildroot_in_bootstrap_mounted():
  279:                     return self._execute_mounted(*args, **kwargs)
  280:         finally:
  281:             self.plugins.call_hooks("postyum")
  282: 
