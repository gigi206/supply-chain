  41: def _package_manager_exists(pm_class, config_opts, chroot=None):
  42:     name = pm_class.name
  43:     command = pm_class.get_command(config_opts)
  44:     pathname = (chroot or "") + command
  45:     if not os.path.isfile(pathname):
  46:         return False
  47:     # resolve symlinks, and detect that e.g. /bin/yum doesn't point to /bin/dnf
  48:     real_pathname = os.path.realpath(pathname)
  49:     if name == 'dnf4':
  50:         # The DNF4 used to be /bin/dnf, not /bin/dnf4
  51:         name = 'dnf'
  52:     return name in real_pathname
  53: 
