  739:     def execute(self, *args, **kwargs):
  740:         args_copy = list(copy.copy(args))
  741:         cmd = args_copy[0]
  742:         if cmd not in ['update', 'remove', 'install']:
  743:             self.command = self.config['dnf_command']
  744:             self.support_installroot = True
  745:             self.config['releasever'] = self.saved_releasever
  746:         # else it is builddep or resolvedep and we keep command == config['microdnf_command']
  747:         if cmd == "dnf-install":
  748:             cmd = args_copy[0] = "install"
  749:         result = super(MicroDnf, self).execute(*args_copy, **kwargs)
  750:         # restore original value
  751:         self.command = self.config['microdnf_command']
  752:         self.support_installroot = False
  753:         self.config['releasever'] = None
  754:         return result
