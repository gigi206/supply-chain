  29: def _package_manager_from_string(name):
  30:     if name == 'dnf5':
  31:         return Dnf5
  32:     if name == 'yum':
  33:         return Yum
  34:     if name in 'dnf4':
  35:         return Dnf
  36:     if name == 'microdnf':
  37:         return MicroDnf
  38:     raise RuntimeError(f'Unrecognized package manager "{name}"')
  39: 
