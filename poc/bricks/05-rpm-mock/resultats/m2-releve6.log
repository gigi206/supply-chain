  166:     def adjust_command_options(self, command, opts):
  167:         """
  168:         E.g. --allowerasing is supported by DNF5 in general, but is not
  169:         supported by DNF5 builddep plugin (yet), therefore we can configure:
  170:         config_opts["dnf5_avoid_opts"]["builddep"] = ["--allowerasing"]
  171:         https://github.com/rpm-software-management/dnf5/issues/461
  172:         """
  173:         config = self.config.get(f"{self.name}_avoid_opts", {})
  174:         if command in config:
  175:             return [o for o in opts if o not in config[command]]
  176:         return opts
