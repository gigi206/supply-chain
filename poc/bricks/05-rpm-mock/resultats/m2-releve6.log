  55: def _package_manager_class_fallback(config_opts, buildroot, fallback):
  56:     desired = config_opts['package_manager']
  57: 
  58:     if desired == 'dnf':  # backward compat
  59:         desired = 'dnf4'
  60: 
  61:     if not fallback:
  62:         return _package_manager_from_string(desired)
  63: 
  64:     getLog().debug("searching for '%s' package manager or alternatives", desired)
  65:     if desired not in fallbacks:
  66:         raise RuntimeError(f'Unexpected package manager "{desired}"')
  67: 
  68:     chroot_to_search_in = None  # by default we search for PMs on host
  69:     if buildroot.uses_bootstrap_image:
  70:         # alternatively in the (extracted) bootstrap image
  71:         chroot_to_search_in = buildroot.make_chroot_path()
  72: 
  73:     bootstrap = buildroot.is_bootstrap
  74: 
  75:     for manager in fallbacks[desired]:
  76:         pm_class = _package_manager_from_string(manager)
  77:         if _package_manager_exists(pm_class, config_opts, chroot=chroot_to_search_in):
  78:             if desired == manager:
  79:                 return pm_class
  80: 
  81:             getLog().info("Using '%s' instead of '%s'%s", manager, desired,
  82:                           " for bootstrap chroot" if bootstrap else "")
  83: 
  84:             if 'dnf_warning' in config_opts and not config_opts['dnf_warning']:
  85:                 return pm_class
  86: 
  87:             if not bootstrap:
  88:                 # pylint: disable=consider-using-f-string
  89:                 print("""WARNING! WARNING! WARNING!
  90: You are building package for distribution which uses {0}. However your system
  91: does not support {0}. You can continue with {1}, which will likely succeed,
  92: but the installed chroot may look a little different.
  93:   1. Please consider --bootstrap-chroot option, or
  94:   2. install {0} on your host system.
  95: You can suppress this warning when you put
  96:   config_opts['dnf_warning'] = False
  97: in Mock config.""".format(desired.upper(), manager.upper()))
  98:                 input("Press Enter to continue.")
  99: 
  100:             return pm_class
  101: 
  102:     raise RuntimeError(f"No package from {fallbacks[desired]} found, desired {desired}")
  103: 
