  178:     def log_package_management_packages(self):
  179:         """
  180:         Log out the versions of packages related to package management.
  181:         """
  182:         if self.buildroot.is_bootstrap:
  183:             # no-op for the bootstrap chroot;  we don't care how this has been
  184:             # installed
  185:             return
  186: 
  187:         cmd = [
  188:             "rpm", "-q",
  189:             "rpm", "rpm-sequoia",
  190:             "python3-dnf", "python3-dnf-plugins-core",
  191:             "yum", "yum-utils",
  192:             "dnf5", "dnf5-plugins",
  193:         ]
