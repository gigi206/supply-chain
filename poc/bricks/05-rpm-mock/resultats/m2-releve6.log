  219:     @traceLog()
  220:     def build_invocation(self, *args):
  221:         invocation = []
  222:         args = list(args)
  223:         cmd = args[0]
  224:         opts = self.adjust_command_options(cmd, copy.copy(self.common_opts))
  225:         if cmd == 'builddep':
  226:             args = args[1:]
  227:             invocation += self.builddep_command
  228:             opts += self.config.get(self.name + '_builddep_opts', [])
  229:         elif cmd == 'resolvedep':
  230:             if self.resolvedep_command:
  231:                 args = args[1:]
  232:                 invocation = self.resolvedep_command
  233:             else:
  234:                 invocation = [self.command]
  235:         else:
  236:             invocation = [self.command]
  237:         if self.support_installroot and not self.is_bootstrap_image:
  238:             invocation += ['--installroot', self.buildroot.make_chroot_path('')]
  239:         if cmd in ['upgrade', 'update', 'module']:
  240:             invocation += ['-y']
  241:         releasever = self.config['releasever']
  242:         if releasever:
  243:             invocation += ['--releasever', str(releasever)]
  244:         if not self.config['online']:
  245:             invocation.append('-C')
  246:         if self.config['enable_disable_repos']:
  247:             invocation += self.config['enable_disable_repos']
  248: 
  249:         invocation += (args + opts) if self.place_common_opts_after else (opts + args)
  250: 
  251:         return invocation
