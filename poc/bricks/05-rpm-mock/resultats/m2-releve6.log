  454:     def expand_url_vars(self, string):
  455:         """
  456:         Expand DNF variables like $baseurl to proper values in string, and
  457:         return it.
  458:         """
  459:         expand = {
  460:             "basearch": self.config["target_arch"] or '<undef>',
  461:             "releasever": self.config["releasever"] or '<undef>',
  462:         }
  463: 
  464:         if 'dnf_vars' in self.config:
  465:             for key in self.config['dnf_vars']:
  466:                 expand[key] = self.config['dnf_vars'][key]
  467: 
  468:         for key, value in expand.items():
  469:             # replace both $key and ${key}
  470:             # dnf allows braced variables
  471:             string = string.replace('$' + key, value)
  472:             string = string.replace('${' + key + '}', value)
  473: 
  474:         return string
  475: 
  476:     def _bind_mount_repos_to_bootstrap(self):
  477:         if not self.buildroot.is_bootstrap:
  478:             return
  479: 
  480:         parse = {
  481:             "baseurl": (True, re.compile("[ \t\n,]")),
  482:             "mirrorlist": (False, None),
  483:             "metalink": (False, None),
  484:         }
  485: 
  486:         # in dnf, the last occurence of the same option beats the previous
  487:         config = ConfigParser(strict=False, interpolation=None)
  488:         config.read_string(self.pkg_manager_config)
  489: 
  490:         # don't bindmount the same paths multiple times
  491:         tried = set()
  492: 
  493:         for section in config.sections():
  494:             for option in parse:
  495:                 directory, split_re = parse[option]
  496: 
  497:                 if option not in config[section]:
  498:                     continue
  499: 
  500:                 raw = config[section][option]
  501:                 items = split_re.split(raw) if split_re else [raw]
  502: 
  503:                 for value in items:
  504:                     value = value.strip()
  505:                     if not value:
  506:                         continue
  507: 
  508:                     # triple slash, we only accept absolute pathnames
  509:                     if value.startswith('file:///'):
  510:                         srcpath = value[7:]
  511:                     elif value.startswith('/'):
  512:                         srcpath = value
  513:                     else:
  514:                         continue
  515: 
  516:                     srcpath = self.expand_url_vars(srcpath)
  517:                     srcpath = unquote(srcpath)
  518: 
  519:                     if srcpath in tried:
  520:                         continue
  521: 
  522:                     tried.add(srcpath)
  523: 
  524:                     if directory and not os.path.isdir(srcpath):
  525:                         continue
  526: 
  527:                     if not os.path.exists(srcpath):
  528:                         continue
  529: 
  530:                     bindpath = self.buildroot.make_chroot_path(srcpath)
  531:                     bind_mount_point = BindMountPoint(srcpath=srcpath,
  532:                                                       bindpath=bindpath)
  533: 
  534:                     # This is a very tricky hack.  Note we configure the
  535:                     # package_manager for the "bootstrap" chroot here, but these
  536:                     # "local repo" mountpoints are actually needed by both
  537:                     # "bootstrap" and "build" chroots.  The "bootstrap" chroot
  538:                     # needs this with the 'bootstrap_image' feature (we use
  539:                     # package manager _in bootstrap_, not on host, to install
  540:                     # into the bootstrap) and the "build" chroot package manager
