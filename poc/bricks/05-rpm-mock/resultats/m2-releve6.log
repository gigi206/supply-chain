  196:         def _do(comment, *args, **kwargs):
  197:             info = "Buildroot is handled by package management"
  198:             output = util.do(*args, **kwargs, returnOutput=True,
  199:                                   raiseExc=False).strip()
  200:             output = "\n".join(["  " + line for line in output.split("\n")
  201:                                 if "is not installed" not in line])
  202:             getLog().info("%s %s:\n%s", info, comment, output)
  203: 
  204:         # We want to know the package versions in bootstrap
  205:         if self.bootstrap_buildroot:
  206:             if self.bootstrap_buildroot.use_chroot_image:
  207:                 # rpm installed from the bootstrap image
  208:                 _do("downloaded with a bootstrap image", cmd,
  209:                     chrootPath=self.bootstrap_buildroot.make_chroot_path())
  210:             else:
  211:                 # rpm installed into bootstrap by host's package management
  212:                 _do("installed into bootstrap", cmd + [
  213:                     "--root", self.bootstrap_buildroot.make_chroot_path()
  214:                 ])
  215:         else:
  216:             # Execute with installroot from host
  217:             _do("from host and used with --installroot", cmd)
