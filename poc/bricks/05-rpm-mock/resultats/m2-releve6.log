  105: def package_manager(buildroot, bootstrap_buildroot, fallback):
  106:     cls = _package_manager_class_fallback(buildroot.config, buildroot, fallback)
  107:     return cls(buildroot.config, buildroot, buildroot.plugins,
  108:                bootstrap_buildroot)
