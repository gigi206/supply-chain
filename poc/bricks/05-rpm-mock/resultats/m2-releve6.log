  284:     @traceLog()
  285:     def _execute_mounted(self, *args, **kwargs):
  286: 
  287:         # intentionally we do not call bootstrap hook here - it does not have sense
  288:         env = self.config['environment'].copy()
  289:         env.update(util.get_proxy_environment(self.config))
  290:         # installation-time specific homedir
  291:         env['HOME'] = self.buildroot.prepare_installation_time_homedir()
  292:         env['LC_MESSAGES'] = 'C.UTF-8'
  293:         if self.buildroot.nosync_path:
  294:             env['LD_PRELOAD'] = self.buildroot.nosync_path
  295:         invocation = self.build_invocation(*args)
  296:         self.buildroot.root_log.debug(invocation)
  297:         kwargs.setdefault("pivot_root_chroot", self.buildroot.config.get("pivot_root_chroot", False))
  298:         kwargs['printOutput'] = kwargs.get('printOutput', True)
  299:         if not self.config['print_main_output']:
  300:             kwargs.pop('printOutput', None)
  301:         else:
  302:             kwargs.setdefault("pty", True)
  303:         self.buildroot.nuke_rpm_db()
  304: 
  305:         error = None
  306:         max_attempts = int(self.config['package_manager_max_attempts'])
  307:         for attempt in range(max(max_attempts, 1)):
  308:             if error:
  309:                 sleep_seconds = int(self.config['package_manager_attempt_delay'])
  310:                 self.buildroot.root_log.warning(
  311:                         "%s command failed, retrying, attempt #%s, sleeping %ss",
  312:                     self.name.upper(), attempt + 1, sleep_seconds)
  313:                 time.sleep(sleep_seconds)
  314: 
  315:             try:
  316:                 # either it does not support --installroot (microdnf) or
  317:                 # it is bootstrap image made by container with incomaptible dnf/rpm
  318:                 personality = kwargs.pop("personality", None)
  319:                 if self.buildroot.is_bootstrap and not self.buildroot.config["forcearch"]:
  320:                     personality = self.buildroot.config["repo_arch"]
  321: 
  322:                 if not self.support_installroot or self.is_bootstrap_image:
  323:                     out = util.do(invocation, env=env,
  324:                                   chrootPath=self.buildroot.make_chroot_path(),
  325:                                   personality=personality, **kwargs)
  326:                 elif self.bootstrap_buildroot is None:
  327: 
  328: 
  329:                     out = util.do(invocation, env=env,
  330:                                   personality=personality, **kwargs)
  331:                 else:
  332:                     out = util.do(invocation, env=env,
  333:                                   chrootPath=self.bootstrap_buildroot.make_chroot_path(),
  334:                                   nspawn_args=self.bootstrap_buildroot.config['nspawn_args'],
  335:                                   personality=personality, **kwargs)
  336:                 error = None
  337:                 break
  338:             except Error as e:
  339:                 error = YumError(str(e))
  340: 
  341:         if error is not None:
  342:             raise error
  343: 
  344:         # intentionally we do not call bootstrap hook here - it does not have sense
  345:         return out
