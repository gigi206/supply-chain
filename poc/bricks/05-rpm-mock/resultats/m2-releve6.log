  111: class _PackageManager(object):
  112:     # pylint: disable=too-many-instance-attributes
  113:     name = None
  114:     command = None
  115:     builddep_command = None
  116:     resolvedep_command = None
  117:     # When support_installroot is False then command is run in target chroot
  118:     # you must ensure that `command` is available in the chroot
  119:     support_installroot = True
  120:     # We specify (historical reasons) opts before args for package managers.
  121:     # But DNF5 requires the common opts (--allowerasing etc.) specified after
  122:     # the sub-command (like 'install --allowerasing', instead of
  123:     # '--allowerasing install').
  124:     place_common_opts_after = False
  125: 
  126:     @classmethod
  127:     def get_command(cls, config):
  128:         command = config.get(f"{cls.name}_command")
  129:         if config.get("use_bootstrap_image", True):
  130:             return command
  131:         if config.get("use_bootstrap", False):
  132:             sys_command = config.get(f"{cls.name}_system_command")
  133:             if sys_command:
  134:                 return sys_command
  135:         return command
