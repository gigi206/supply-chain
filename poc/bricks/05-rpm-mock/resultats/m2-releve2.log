  126: def prepare_image(image_specification, bootstrap_data, outputdir):
  127:     """
  128:     Store the tarball into the same directory where the RPMs are
  129:     """
  130:     # --scoped - it is better to refer will full repo name instead of just tag@sha
  131:     #            also it matches with full pullspec from config's bootstrap_image
  132:     # --preserve-digests - it is not needed for most images, but some could end with
  133:     #            modified digests (semantically identical copy, but modified digest,
  134:     #            e.g. embedded docker reference for v1 images), so better safe than sorry
  135:     pull_cmd = ["skopeo", "sync", "--src", "docker", "--dest", "dir",
  136:                 "--scoped", "--preserve-digests"]
  137:     # skopeo (currently) can't live with tag + sha, so strip the tag
  138:     image_specification = image_specification.split(':')[0]
  139:     if "architecture" in bootstrap_data:
  140:         pull_cmd += ["--override-arch", bootstrap_data["architecture"]]
  141:     if "pull_digest" in bootstrap_data:
  142:         image_specification +=  "@" + bootstrap_data["pull_digest"]
  143:     pull_cmd += [image_specification, outputdir]
  144:     log.info("Pulling like: %s", ' '.join(pull_cmd))
  145:     subprocess.check_output(pull_cmd)
