  148: def _main():
  149:     options = _argparser().parse_args()
  150: 
  151:     # Build host -> (cert_path, key_path|None) mapping
  152:     client_auth_map = {}
  153:     if getattr(options, "client_cert_for", None):
  154:         for parts in options.client_cert_for:
  155:             if len(parts) < 2 or len(parts) > 3:
  156:                 log.error("Invalid --client-cert-for usage (expected: --client-cert-for HOST CERT [KEY]) -> %s", parts)
  157:                 sys.exit(2)
  158:             host = parts[0]
  159:             cert_path = parts[1]
  160:             key_path = parts[2] if len(parts) == 3 else None
  161:             if not cert_path:
  162:                 log.error("Invalid --client-cert-for value for %s (missing CERT path)", host)
  163:                 sys.exit(2)
  164:             if not os.path.isfile(cert_path):
  165:                 log.error("Client certificate file does not exist for %s: %s", host, cert_path)
  166:                 sys.exit(2)
  167:             if key_path and not os.path.isfile(key_path):
  168:                 log.error("Client key file does not exist for %s: %s", host, key_path)
  169:                 sys.exit(2)
  170:             # Log registration without printing key path
  171:             if key_path:
  172:                 log.info("Registering client certificate for %s: cert=%s (key provided)", host, cert_path)
  173:             else:
  174:                 log.info("Registering client certificate for %s: cert=%s", host, cert_path)
  175:             client_auth_map[host] = (cert_path, key_path)
  176: 
  177:     with open(options.lockfile, "r", encoding="utf-8") as fd:
  178:         data = json.load(fd)
  179: 
  180:     try:
  181:         os.makedirs(options.output_repo)
  182:     except FileExistsError:
  183:         pass
  184: 
  185:     failed = False
  186:     urls = [i["url"] for i in data["buildroot"]["rpms"]]
  187:     with concurrent.futures.ThreadPoolExecutor(max_workers=10) as executor:
  188:         for i, out in zip(urls, executor.map(download_file,
  189:                                              urls,
  190:                                              [options.output_repo for _ in urls],
  191:                                              [client_auth_map for _ in urls])):
  192:             if out is False:
  193:                 log.error("Download failed: %s", i)
  194:                 failed = True
  195:     if failed:
  196:         log.error("RPM deps downloading failed")
  197:         sys.exit(1)
  198: 
  199:     subprocess.check_call(["createrepo_c", "--compatibility", options.output_repo])
  200: 
  201:     prepare_image(data["config"]["bootstrap_image"], data["bootstrap"],
  202:                   options.output_repo)
