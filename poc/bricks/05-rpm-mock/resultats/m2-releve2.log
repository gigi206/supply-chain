  1: #! /usr/bin/python3
  2: 
  3: """
  4: Take the JSON provided by Mock, download corresponding RPMs, and put them into
  5: an RPM repository.
  6: """
  7: 
  8: # pylint: disable=invalid-name
  9: 
  10: import argparse
  11: import concurrent.futures
  12: import json
  13: import logging
  14: import os
  15: import shutil
  16: import subprocess
  17: import sys
  18: 
  19: from urllib.parse import quote, urlparse
  20: from requests.adapters import HTTPAdapter
  21: from requests.packages.urllib3.util.retry import Retry
  22: 
  23: import requests
  24: 
  25: logging.basicConfig(level=logging.DEBUG)
  26: log = logging.getLogger(__name__)
  27: 
  28: 
  29: def request_with_retry(retries=5, backoff_factor=0.3,
  30:                        status_forcelist=(500, 502, 503, 504, 408, 429), session=None):
  31:     """
  32:     Wrapper for requests Session with default retries
  33: 
  34:     Converted from koji:
  35:     https://pagure.io/koji/blob/fccf4fa3f990ca454a411c8a699e693f4e5b0ac8/f/koji/__init__.py#_2004
  36:     originally stolen from
  37:     https://www.peterbe.com/plog/best-practice-with-retries-with-requests
  38:     """
  39:     session = session or requests.Session()
  40:     retry = Retry(total=retries, read=retries, connect=retries,
  41:                   backoff_factor=backoff_factor,
  42:                   status_forcelist=status_forcelist)
  43:     adapter = HTTPAdapter(max_retries=retry)
  44:     session.mount('http://', adapter)
  45:     session.mount('https://', adapter)
  46:     return session
  47: 
  48: 
  49: def download_file(url, outputdir, client_auth_map):
  50:     """
  51:     Download a single file (pool worker)
  52:     """
  53:     basename = os.path.basename(url)
  54:     file_name = os.path.join(outputdir, basename)
  55:     dirname = os.path.dirname(url)
  56: 
  57:     # basename often contains '+' character, e.g., g++ package, url-encode it
  58:     url = dirname + "/" + quote(basename)
  59:     log.info("Downloading %s", url)
  60: 
  61:     try:
  62:         parsed = urlparse(url)
  63:         host_with_port = parsed.netloc
  64:         host_only = parsed.hostname or host_with_port
  65: 
  66:         cert_arg = None
  67:         # Prefer exact host:port mapping, then hostname-only
  68:         mapping_value = client_auth_map.get(host_with_port) or client_auth_map.get(host_only)
  69:         if mapping_value:
  70:             cert_path, key_path = mapping_value
  71:             cert_arg = (cert_path, key_path) if key_path else cert_path
  72: 
  73:         session = request_with_retry()
  74:         request_kwargs = {"stream": True, "timeout": 60}
  75:         if cert_arg is not None:
  76:             request_kwargs["cert"] = cert_arg
  77: 
  78:         with session.get(url, **request_kwargs) as response:
  79:             if response.status_code != 200:
  80:                 return False
  81:             with open(file_name, "wb") as fd:
  82:                 shutil.copyfileobj(response.raw, fd)
  83:             return True
  84:     except:  # noqa: E722
  85:         log.exception("Exception raised for %s", url)
  86:         raise
  87: 
  88: 
  89: def _argparser():
  90:     parser = argparse.ArgumentParser(
  91:         prog='mock-hermetic-repo',
  92:         description=(
  93:             "Prepare a repository for a `mock --hermetic-build` build. "
  94:             "Given a Mock buildroot \"lockfile\"\n\n"
  95:             "  a) create an output repo directory,\n"
  96:             "  b) download and place all the necessary RPM files there,\n"
  97:             "  c) create a local RPM repository there (run createrepo), and\n"
  98:             "  d) dump there also the previously used bootstrap image as "
  99:             "a tarball.\n\n"
  100:             "Lockfile is a buildroot_lock.json file from Mock's "
  101:             "result directory; it is a JSON file generated by the "
  102:             "--calculate-build-dependencies option/buildroot_lock "
  103:             "plugin."),
  104:         formatter_class=argparse.RawTextHelpFormatter,
  105:     )
  106:     parser.add_argument("--lockfile", required=True,
  107:                         help=(
  108:                             "Select buildroot_lock.json filename on your system, "
  109:                             "typically located in the Mock's result directory "
  110:                             "upon the --calculate-build-dependencies mode "
  111:                             "execution."))
  112:     parser.add_argument("--output-repo", required=True,
  113:                         help=(
  114:                             "Download RPMs into this directory, and then run "
  115:                             "/bin/createrepo_c utility there to populate the "
  116:                             "RPM repo metadata."))
  117:     parser.add_argument("--client-cert-for", dest="client_cert_for",
  118:                         action="append", nargs='+', metavar="HOST CERT [KEY]",
  119:                         help=(
  120:                             "Register a client certificate (and optional key) to use for a "
  121:                             "specific host. Repeatable. Usage: \n"
  122:                             "  --client-cert-for HOST CERT [KEY]"))
  123:     return parser
