  22:     """ Produces buildroot_lock.json file in resultdir """
  23:     def __init__(self, plugins, conf, buildroot):
  24:         self.buildroot = buildroot
  25:         self.state = buildroot.state
  26:         self.conf = conf
  27:         self.inst_done = False
  28:         plugins.add_hook("postdeps", self.produce_lockfile)
  29: 
  30:     def produce_lockfile(self):
  31:         """
  32:         Upon a request ('produce_lockfile' option set True), generate
  33:         the mock-build-environment.json file in resultdir.  The file describes
  34:         the Mock build environment, and the way to reproduce it.
  35:         """
  36: 
  37:         filename = "buildroot_lock.json"
  38:         statename = "Generating the buildroot lockfile: " + filename
  39:         try:
  40:             with self.buildroot.uid_manager:
  41:                 self.state.start(statename)
  42:                 out_file = os.path.join(self.buildroot.resultdir, filename)
  43:                 chrootpath = self.buildroot.make_chroot_path()
  44: 
  45:                 # Ḿimic the Koji Content Generator metadata fields:
  46:                 # https://docs.pagure.org/koji/content_generator_metadata/#buildroots
  47:                 #
  48:                 # The query_packages() method below sorts its output according
  49:                 # to _values_ of the queried RPM headers, so keep name-arch pair
  50:                 # first to have the output sorted reasonably.
  51:                 query_fields = ["name", "arch", "license", "version", "release",
  52:                                 "epoch", "sigmd5", "signature"]
  53: 
  54:                 def _executor(cmd):
  55:                     with self.buildroot.uid_manager.elevated_privileges():
  56:                         out, _ = self.buildroot.doOutChroot(cmd,
  57:                                                             returnOutput=True,
  58:                                                             returnStderr=False)
  59:                         return out
  60: 
  61:                 packages = query_packages(query_fields, chrootpath, _executor)
  62:                 query_packages_location(packages, chrootpath, _executor,
  63:                                         dnf_cmd=self.buildroot.pkg_manager.command)
  64: 
  65:                 data = {
  66:                     # Try to semver.  The future Mock versions (the tool) should
  67:                     # be able to read older Minor versions of the same Major.
  68:                     # Anytime we break this assumption, bump the Major.  IOW,
  69:                     # the latest Mock implementing with Major == 1 can read any
  70:                     # version from the 1.Y.Z range.  Mock implementing v2.Y.Z
  71:                     # no longer reads v1.Y.Z variants.
  72:                     "version": "1.1.0",
  73:                     "buildroot": {
  74:                         "rpms": packages,
  75:                     },
  76:                     # Try to keep this as minimal as possible.  If possible,
  77:                     # implement the config options as DEFAULTS in the
  78:                     # hermetic-build.cfg, or in the
  79:                     # process_hermetic_build_config() method.
  80:                     "config": {}
  81:                 }
  82:                 for cfg_option in [
  83:                     # These are hard-coded in the configuration file, but we
  84:                     # work with a single-config-for-all-arches now.
  85:                     "target_arch",
  86:                     "legal_host_arches",
  87:                     "dist",
  88:                     "package_manager",
  89:                     # At this point, we only support hermetic builds iff
  90:                     # bootstrap_image_ready=True, so these two options are
  91:                     # useful for implementing "assertion" in the
  92:                     # process_hermetic_build_config() method.
  93:                     "bootstrap_image",
  94:                     "bootstrap_image_ready",
  95:                     # Macros need to be inherited, e.g., to keep the original
  96:                     # %vendor tag specification, or %_host_cpu hacks.
  97:                     "macros",
  98:                 ]:
  99:                     if cfg_option in self.buildroot.config:
  100:                         data["config"][cfg_option] = self.buildroot.config[cfg_option]
  101: 
  102:                 # The 'bootstrap' field is omitted when 'use_bootstrap_image'
  103:                 # is False.  Consequently, we cannot perform a subsequent
  104:                 # hermetic build using this lockfile.
  105:                 if self.buildroot.config["use_bootstrap_image"]:
  106:                     with self.buildroot.uid_manager.elevated_privileges():
  107:                         try:
  108:                             podman = Podman(self.buildroot,
  109:                                             data["config"]["bootstrap_image"])
  110:                             data["bootstrap"] = podman.inspect_hermetic_metadata()
  111:                             data["bootstrap"]["image_digest"] = podman.get_oci_digest()
  112:                         except PodmanError:
  113:                             data["bootstrap"] = {}
  114: 
  115:                 with open(out_file, "w", encoding="utf-8") as fdlist:
  116:                     fdlist.write(json.dumps(data, indent=4, sort_keys=True) + "\n")
  117:         finally:
  118:             self.state.finish(statename)
