### RetrieveMaterialsFromStructuredResults (ligne 263)
263: func RetrieveMaterialsFromStructuredResults(ctx context.Context, objResults []objects.Result) []common.ProvenanceMaterial {
264: 	logger := logging.FromContext(ctx)
265: 	// Retrieve structured provenance for inputs.
266: 	mats := []common.ProvenanceMaterial{}
267: 	ssts := ExtractStructuredTargetFromResults(ctx, objResults, ArtifactsInputsResultName)
268: 	for _, s := range ssts {
269: 		alg, digest, err := ParseDigest(s.Digest)
270: 		if err != nil {
271: 			logger.Debugf("Digest for %s not in the right format: %s, %v", s.URI, s.Digest, err)
272: 			continue
273: 		}
274: 		mats = append(mats, common.ProvenanceMaterial{
275: 			URI:    s.URI,
276: 			Digest: map[string]string{alg: digest},
277: 		})
278: 	}
279: 	return mats
280: }

### ExtractStructuredTargetFromResults (ligne 284)
284: func ExtractStructuredTargetFromResults(ctx context.Context, objResults []objects.Result, categoryMarker string) []*StructuredSignable {
285: 	logger := logging.FromContext(ctx)
286: 	objs := []*StructuredSignable{}
287: 	if categoryMarker != ArtifactsInputsResultName && categoryMarker != ArtifactsOutputsResultName {
288: 		return objs
289: 	}
290: 
291: 	// TODO(#592): support structured results using Run
292: 	for _, res := range objResults {
293: 		if strings.HasSuffix(res.Name, categoryMarker) {
294: 			valid, err := isStructuredResult(res, categoryMarker)
295: 			if err != nil {
296: 				logger.Debugf("ExtractStructuredTargetFromResults: %v", err)
297: 			}
298: 			if valid {
299: 				logger.Debugf("Extracted Structured data from Result %s, %s", res.Value.ObjectVal["uri"], res.Value.ObjectVal["digest"])
300: 				objs = append(objs, &StructuredSignable{URI: res.Value.ObjectVal["uri"], Digest: res.Value.ObjectVal["digest"]})
301: 			}
302: 		}
303: 	}
304: 	return objs
305: }

