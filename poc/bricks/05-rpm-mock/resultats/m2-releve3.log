  239:     def untag(self):
  240:         """
  241:         Remove the additional image ID we created - which means the image itself
  242:         is garbage-collected if there's no other tag.
  243:         """
  244:         cmd = ["podman", "rmi", self._tagged_id]
  245:         getLog().info("Removing image %s", self._tagged_id)
  246:         subprocess.run(cmd, env=self.buildroot.env, stdout=subprocess.PIPE,
