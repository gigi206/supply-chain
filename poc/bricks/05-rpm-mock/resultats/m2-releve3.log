  62: def podman_check_native_image_architecture(image, logger=None, podman_binary=None):
  63:     """
  64:     Return True if image's architecture is "native" for this host.
  65:     Relates:
  66:         https://github.com/containers/podman/issues/19717
  67:         https://github.com/fedora-copr/copr/issues/2875
  68:     """
  69: 
  70:     logger = logger or logging.getLogger()
  71:     podman = podman_binary or "/usr/bin/podman"
  72:     logger.info("Checking that %s image matches host's architecture", image)
  73:     sys_check_cmd = [podman, "version", "--format", "{{.OsArch}}"]
  74:     image_check_cmd = [podman, "image", "inspect",
  75:                        "--format", "{{.Os}}/{{.Architecture}}", image]
  76: 
  77:     def _podman_query(cmd):
  78:         return subprocess.check_output(cmd, encoding="utf8").strip()
  79: 
  80:     try:
  81:         system_arch = _podman_query(sys_check_cmd)
  82:         image_arch = _podman_query(image_check_cmd)
  83:         if system_arch != image_arch:
  84:             logger.error("Image architecture %s doesn't match system arch %s",
  85:                          image_arch, system_arch)
  86:             return False
  87:     except subprocess.SubprocessError as exc:
  88:         logger.error("Subprocess failed: %s", exc)
  89:         return False
  90: 
  91:     return True
