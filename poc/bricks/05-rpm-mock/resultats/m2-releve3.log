  223:     @traceLog()
  224:     def cp(self, destination, tar_cmd):
  225:         """ copy content of container to destination directory """
  226:         getLog().info("Copy content of container %s to %s", self.image_id, destination)
  227: 
  228:         with self.mounted_image() as mount_path:
  229:             # pipe-out the temporary mountpoint with the help of tar utility
  230:             cmd_podman = [tar_cmd, "-C", mount_path, "-c", "."]
  231:             with subprocess.Popen(cmd_podman, stdout=subprocess.PIPE) as podman:
  232:                 # read the tarball from stdin, and extract to the destination
  233:                 # directory (chroot directory)
  234:                 cmd_tar = [tar_cmd, "-xC", destination, "-f", "-"]
  235:                 with subprocess.Popen(cmd_tar, stdin=podman.stdout) as tar:
  236:                     tar.communicate()
  237:                     podman.communicate()
