  101: class Podman:
  102:     """ interacts with podman to create build chroot """
  103: 
  104:     @traceLog()
  105:     def __init__(self, buildroot, image):
  106:         self.podman_binary = "/usr/bin/podman"
  107:         if not os.path.exists(self.podman_binary):
  108:             raise PodmanError(f"'{self.podman_binary}' not installed")
  109: 
  110:         self.buildroot = buildroot
  111:         self.image = image
  112:         self.image_id = None
  113:         getLog().info("Using container image: %s", image)
  114: 
  115:     @traceLog()
  116:     def pull_image(self, timeout=None):
  117:         """Pull the latest image, return True if successful."""
  118:         logger = getLog()
  119:         logger.info("Pulling image: %s", self.image)
  120:         cmd = [self.podman_binary, "pull"]
  121:         # Temporary workaround, see oci_platform_map in config.py and PR #1733/#1783.
  122:         target_arch = self.buildroot.config.get('target_arch', '')
  123:         oci_platform = self.buildroot.config.get('oci_platform_map', {}).get(target_arch)
  124:         if oci_platform:
  125:             cmd += ["--platform", oci_platform]
  126:         cmd.append(self.image)
  127: 
  128:         try:
  129:             res = subprocess.run(cmd, env=self.buildroot.env,
  130:                                  stdout=subprocess.PIPE, stderr=subprocess.PIPE,
  131:                                  timeout=timeout, check=False)
  132:         except subprocess.TimeoutExpired:
  133:             logger.warning("Pulling image %s timed out after %s seconds",
  134:                            self.image, timeout)
  135:             return False
  136: 
  137:         if res.returncode != 0:
  138:             logger.error("%s\n%s", res.stdout, res.stderr)
  139:             return False
  140: 
  141:         # Record the image id for later use.  This is needed for the
  142:         # oci-image:tarball images that not necessarily have tags/names.
  143:         self.image_id = res.stdout.decode("utf-8").strip()
  144:         return True
  145: 
  146:     @property
  147:     def _tagged_id(self):
  148:         uuid = self.buildroot.config["mock_run_uuid"]
  149:         bootstrap = "-bootstrap" if self.buildroot.is_bootstrap else ""
  150:         return f"mock{bootstrap}-{uuid}"
  151: 
  152:     def tag_image(self):
  153:         """
  154:         Tag the pulled image as mock-{uuid}, or mock-bootstrap-{uuid}.
  155:         """
  156:         if not self.image_id:
  157:             raise PodmanError("No image to tag. Image pull failed or was not attempted")
  158:         cmd = ["podman", "tag", self.image_id, self._tagged_id]
  159:         getLog().info("Tagging container image as %s", self._tagged_id)
  160:         subprocess.run(cmd, env=self.buildroot.env, stdout=subprocess.PIPE,
  161:                        stderr=subprocess.PIPE, check=True)
  162: 
  163:     def retry_image_pull(self, max_time, timeout=None):
  164:         """Try pulling the image multiple times."""
  165:         @backoff.on_predicate(backoff.expo, lambda x: not x,
  166:                               max_time=max_time, jitter=backoff.full_jitter,
  167:                               on_giveup=pull_fail_handler)
  168:         def _keep_trying():
  169:             return self.pull_image(timeout=timeout)
  170:         _keep_trying()
