  172:     @contextmanager
  173:     def mounted_image(self):
  174:         """
  175:         Using the "podman image mount" command, mount the image as a temporary
  176:         read-only directory so we can copy-paste the contents into the final
  177:         chroot directory.
  178:         """
  179:         logger = getLog()
  180:         cmd_mount = [self.podman_binary, "image", "mount", self.image_id]
  181:         cmd_umount = [self.podman_binary, "image", "umount", self.image_id]
  182:         result = subprocess.run(cmd_mount, stdout=subprocess.PIPE,
  183:                                 stderr=subprocess.PIPE, check=False,
  184:                                 encoding="utf8")
  185:         if result.returncode:
  186:             message = "Podman mount failed: " + result.stderr
  187:             raise PodmanError(message)
  188: 
  189:         mountpoint = result.stdout.strip()
  190:         logger.info("mounting %s with podman image mount", self.image_id)
  191:         try:
  192:             logger.info("image %s as %s", self.image_id, mountpoint)
  193:             yield mountpoint
  194:         finally:
  195:             logger.info("umounting image %s (%s) with podman image umount",
  196:                         self.image_id, mountpoint)
  197:             subprocess.run(cmd_umount, stdout=subprocess.PIPE,
  198:                            stderr=subprocess.PIPE, check=True)
  199: 
  200:     def get_oci_digest(self):
  201:         """
  202:         Get sha256 digest of RootFS layers. This must be identical for
  203:         all images containing same order of layers, thus it can be used
  204:         as the check that we've loaded same image.
  205:         """
  206:         the_image = self.image
  207:         if the_image.startswith("oci-archive:") or the_image.startswith("dir:"):
  208:             # We can't query digest from tarball directly, but note
  209:             # the image needs to be tagged first!
  210:             the_image = self._tagged_id
  211:         digest = podman_get_oci_digest(the_image, logger=getLog())
  212:         if digest is None:
  213:             raise PodmanError(f"Getting OCI digest for image {self.image} failed")
  214:         return digest
