  250:         """
  251:         Given self.image (name), get the image Id.
  252:         """
  253:         cmd = ["podman", "image", "inspect", self.image, "--format",
  254:                "{{ .Id }}"]
  255:         getLog().info("Reading image .ID from %s", self.image)
  256:         res = subprocess.run(cmd, env=self.buildroot.env,
  257:                              stdout=subprocess.PIPE, stderr=subprocess.PIPE,
  258:                              check=True)
  259:         self.image_id = res.stdout.decode("utf-8").strip()
