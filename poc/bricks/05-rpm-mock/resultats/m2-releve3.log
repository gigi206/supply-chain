  262:     def inspect_hermetic_metadata(self):
  263:         """
  264:         Get the image metadata needed for the subsequent hermetic build.
  265:         """
  266:         get_query = '{"pull_digest": "{{ .Digest }}", "id": "{{.Id}}", "architecture": "{{ .Architecture }}"}'
  267:         getLog().info("Reading image %s from %s", get_query, self.image)
  268:         cmd = ["podman", "image", "inspect", "--format", get_query, self.image]
  269:         res = subprocess.run(cmd, env=self.buildroot.env,
  270:                              stdout=subprocess.PIPE, stderr=subprocess.PIPE,
  271:                              check=True)
  272:         return json.loads(res.stdout.decode("utf-8").strip())
