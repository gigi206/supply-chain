  787:     @traceLog()
  788:     def prepare_installation_time_homedir(self):
  789:         """ Create a fake home directory with an appropriate .rpmmacros. """
  790: 
  791:         rpm_config_home = os.path.join(self.rootdir, "installation-homedir")
  792:         file_util.mkdirIfAbsent(rpm_config_home)
  793: 
  794:         # Since /proc and /sys are mounted special filesystems when RPM is running
  795:         # to install the buildroot, it doesn't make sense for RPM to try and
  796:         # set the permissions on them - and that might fail with permission errors.
  797:         with open(os.path.join(rpm_config_home, ".rpmmacros"), "w") as macro_fd:
  798:             macro_fd.write("%_netsharedpath /proc:/sys\n")
  799: 
  800:         # To make the DNF (and wrapped RPM) use the appropriate .rpmmacros file
  801:         # we need to set the $HOME environment variable to non-standard
  802:         # directory.  But note that we don't just set HOME=/rpmconfig because
  803:         # `rpm --rootdir <ROOTDIR>` reads the macros file from caller's
