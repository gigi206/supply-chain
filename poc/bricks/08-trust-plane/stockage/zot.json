{
  "distSpecVersion": "1.1.1",
  "storage": {
    "rootDirectory": "/var/lib/zot",
    "dedupe": true,
    "gc": false
  },
  "http": {
    "address": "192.168.161.13",
    "port": "5000",
    "realm": "zot (PoC supply-chain)",
    "compat": [
      "docker2s2"
    ],
    "tls": {
      "cert": "/etc/zot/tls/zot.crt",
      "key": "/etc/zot/tls/zot.key"
    },
    "auth": {
      "htpasswd": {
        "path": "/etc/zot/htpasswd"
      },
      "failDelay": 1
    },
    "accessControl": {
      "repositories": {
        "**": {
          "anonymousPolicy": [
            "read"
          ],
          "policies": [
            {
              "users": [
                "poc-ecriture"
              ],
              "actions": [
                "read",
                "create",
                "update"
              ]
            }
          ]
        },
        "builds/**": {
          "anonymousPolicy": [
            "read"
          ],
          "policies": [
            {
              "users": [
                "poc-ecriture",
                "poc-build"
              ],
              "actions": [
                "read",
                "create",
                "update"
              ]
            },
            {
              "users": [
                "poc-images"
              ],
              "actions": [
                "read"
              ]
            },
            {
              "users": [
                "poc-images"
              ],
              "actions": [
                "create"
              ],
              "conditions": [
                {
                  "expression": "req.referenceType != \"tag\"",
                  "message": "poc-images : écriture par digest seulement, aucun tag (ni .sig ni .att)"
                }
              ]
            }
          ]
        },
        "horodatage/**": {
          "anonymousPolicy": [
            "read"
          ],
          "policies": [
            {
              "users": [
                "poc-ecriture",
                "poc-horodatage"
              ],
              "actions": [
                "read",
                "create",
                "update"
              ]
            }
          ]
        }
      }
    }
  },
  "log": {
    "level": "info",
    "audit": "/var/log/zot/audit.log"
  }
}
