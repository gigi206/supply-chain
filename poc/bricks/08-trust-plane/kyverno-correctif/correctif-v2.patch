+// tsaTrustedMaterials returns one trusted material per TSA root, each holding
+// only that timestamp authority.
+func tsaTrustedMaterials(roots, intermediates []*x509.Certificate, leaf *x509.Certificate) []root.TrustedMaterial {
+	materials := make([]root.TrustedMaterial, 0, len(roots))
+	for _, tsaRoot := range roots {
+		tsa := &root.SigstoreTimestampingAuthority{
+			Root:          tsaRoot,
+			Intermediates: intermediates,
+			Leaf:          leaf,
+		}
+		materials = append(materials, tsaTrustedMaterial{BaseTrustedMaterial: &root.BaseTrustedMaterial{}, timestampingAuthority: tsa})
+	}
+	return materials
+}
