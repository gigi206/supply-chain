-						Leaf:          opts.TSACertificate,
-					}
-					trustedMaterials = append(trustedMaterials, tsaTrustedMaterial{BaseTrustedMaterial: &root.BaseTrustedMaterial{}, timestampingAuthority: tsa})
+			switch {
+			case opts.TrustedMaterial != nil && len(roots) > 0:
+				opts.TrustedMaterial = append(root.TrustedMaterialCollection{opts.TrustedMaterial}, tsaTrustedMaterials(roots, intermediates, opts.TSACertificate)...)
+			case opts.TrustedMaterial == nil && att.Key != nil:
+				// Key attestors with the transparency log ignored skip the Sigstore
+				// infrastructure, so there is no trusted root to merge into. cosign
+				// verifies Sigstore bundles (v0.3) against TrustedMaterial only and
+				// ignores the TSA* fields set above; with a nil TrustedMaterial,
