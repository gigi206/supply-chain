# Brique 08 : essai hors cluster du retrait des étapes de politique.sh dans preuves.sh (09/11/2026, passage de 14:28:35 UTC).
# Travail local : rien lu ni écrit dans le cluster, Zot ou les VM. Le vrai preuves.sh (corrigé) et celui de HEAD 1ae184d (avant)
# tournent sous env -i, HOME et CONFIANCE_DIR dans un dossier jetable (W, S, O, KUBECONFIG en dépendent, commun.sh lignes 6 à 12),
# PATH réduit à de faux outils qui journalisent leurs appels et échouent, puis /usr/bin et /bin. Seuls sont lancés l'usage (sans
# argument) et les 13 noms d'étapes de politique.sh : lancer refuse avant toute étape et avant chrono (commun.sh:331-332).
# Avant correction, seul l'usage est lancé : un nom d'étape de J6 aurait réellement lancé l'étape.
# Limites : les 30 étapes de J8 ne sont pas lancées (leur présence n'est prouvée que par l'usage) ; resultats/ est comparé par son
# listage (noms, tailles, dates), git status par son empreinte.
# Chemin du dossier personnel remplacé par ~ (aucune occurrence dans les sorties).

## essai.sh (v2)
#!/usr/bin/env bash
# Essai hors cluster du retrait des étapes de politique.sh dans preuves.sh. HOME et CONFIANCE_DIR dans un dossier jetable,
# PATH réduit à de faux outils (kubectl, ssh, scp, curl, oras, cosign, crane, helm, mise, jq, yq) qui journalisent leurs appels
# et échouent, puis /usr/bin et /bin. Aucun appel attendu.
set -u
export LC_ALL=C
A=$1                                 # dossier de la brique 08
D=$(mktemp -d); trap 'rm -rf "$D"' EXIT
mkdir -p "$D/bin" "$D/home" "$D/o"
for o in kubectl ssh scp curl oras cosign crane helm mise jq yq; do
  printf '#!/bin/sh\necho "%s $*" >> "%s/appels"\nexit 1\n' "$o" "$D" > "$D/bin/$o"; chmod +x "$D/bin/$o"
done
: > "$D/appels"
env_essai() { env -i HOME="$D/home" CONFIANCE_DIR="$D/o" PATH="$D/bin:/usr/bin:/bin" LANG=C.UTF-8 "$@"; }
avant_r=$(ls -la --time-style=full-iso "$A/resultats" | sha256sum | cut -c1-16)
avant_g=$(git -C "$A" status --porcelain | sha256sum | cut -c1-16)

echo "# date : $(date -u +%Y-%m-%dT%H:%M:%SZ)"
echo "# preuves.sh (sha256) : $(sha256sum < "$A/preuves.sh" | cut -c1-64)"
echo "# preuves.sh de HEAD $(git -C "$A" rev-parse --short HEAD) (sha256) : $(git -C "$A" show HEAD:./preuves.sh | sha256sum | cut -c1-64)"
liste() { sed -n 's/^usage : [^ ]* //p' | tr -d '…' | tr '|' '\n' | sort; }
echo "## avant : preuves.sh de HEAD sans argument (usage seul, aucune étape lancée)"
git -C "$A" show HEAD:./preuves.sh > "$D/preuves-head.sh"   # 283 Ko : trop long pour un argument de bash -c (v1, code 126)
# sourcé avec $0 = chemin réel de preuves.sh (here, usage) et sans paramètre positionnel restant
env_essai bash -c 'f=$1; shift; . "$f"' "$A/preuves.sh" "$D/preuves-head.sh" > "$D/u0" 2>&1 </dev/null; echo "code : $?"
liste < "$D/u0" > "$D/l0"; echo "étapes listées : $(wc -l < "$D/l0")"
echo "## après : preuves.sh corrigé sans argument"
env_essai bash "$A/preuves.sh" > "$D/u1" 2>&1 </dev/null; echo "code : $?"
liste < "$D/u1" > "$D/l1"; echo "étapes listées : $(wc -l < "$D/l1")"
grep -o '^etape_[a-z_0-9]*' "$A/preuves.sh" | sed 's/^etape_//' | sort -u > "$D/j8"
grep -o '^etape_[a-z_0-9]*' "$A/politique.sh" | sed 's/^etape_//' | sort -u > "$D/j6"
echo "étapes de J8 définies dans preuves.sh : $(wc -l < "$D/j8") ; de J6 dans politique.sh : $(wc -l < "$D/j6")"
echo "avant, listées et de J6 : $(comm -12 "$D/l0" "$D/j6" | wc -l) ; listées et de J8 : $(comm -12 "$D/l0" "$D/j8" | wc -l)"
echo "après, listées et de J6 : $(comm -12 "$D/l1" "$D/j6" | wc -l) ; liste identique aux étapes de J8 : $(cmp -s "$D/l1" "$D/j8" && echo oui || echo non)"
for e in $(cat "$D/j6"); do
  env_essai bash "$A/preuves.sh" "$e" > "$D/o-$e" 2>&1 </dev/null; c=$?
  printf 'après, preuves.sh %-13s code %s : %s\n' "$e" "$c" "$(cat "$D/o-$e")"
done
echo "## relevés"
echo "appels aux faux outils : $(wc -l < "$D/appels")"; cat "$D/appels"
echo "resultats/ inchangé : $([ "$(ls -la --time-style=full-iso "$A/resultats" | sha256sum | cut -c1-16)" = "$avant_r" ] && echo oui || echo non)"
echo "git status inchangé : $([ "$(git -C "$A" status --porcelain | sha256sum | cut -c1-16)" = "$avant_g" ] && echo oui || echo non)"
echo "fichiers créés sous HOME et CONFIANCE_DIR jetables :"; (cd "$D" && find home o -type f | sort)

