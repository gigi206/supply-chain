     >     paquets = l.get('packages')
     >     if not isinstance(paquets, dict) or '' not in paquets:
     >         refus(f'npm {c} : section packages absente ou sans racine')
     >     n = 0
     >     for k, e in paquets.items():
     >         if k == '':
     >             continue
     >         if not isinstance(e, dict) or e.get('link'):
     >             refus(f'npm {c} : entrée {k} : lien ou forme inattendue')
     >         u, i = e.get('resolved'), e.get('integrity')
     >         if not isinstance(u, str) or not u.startswith('https://registry.npmjs.org/'):
     >             refus(f'npm {c} : entrée {k} : resolved {u!r} hors de https://registry.npmjs.org/')
     >         if not isinstance(i, str) or not i.startswith('sha512-'):
     >             refus(f'npm {c} : entrée {k} : integrity sha512 absente')
     >         n += 1
     >     print(f'npm {c} : {nom}, lockfileVersion {l["lockfileVersion"]}, {n} paquet(s), tous de https://registry.npmjs.org/ avec integrity sha512')
     > FIN
