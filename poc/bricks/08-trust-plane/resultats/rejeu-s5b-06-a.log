     > import json, os, sys
     > src, demande = sys.argv[1:]
     > def refus(m):
     >     print('refusé : ' + m, file=sys.stderr); sys.exit(1)
     > try:
     >     d = json.loads(demande)
     > except ValueError:
     >     refus('demande Hermeto illisible')
     > if not isinstance(d, list) or not d:
     >     refus('demande Hermeto : liste non vide attendue')
     > vus = set()
     > for p in d:
     >     if not isinstance(p, dict) or not set(p) <= {'type', 'path'}:
     >         refus(f'entrée non admise : {p!r}')
     >     t, c = p.get('type'), p.get('path', '.')
     >     if t not in ('gomod', 'npm'):
     >         refus(f'type non admis : {t!r}')
     >     if not isinstance(c, str) or not c or c.startswith('/') or '..' in c.split('/'):
     >         refus(f'chemin non admis : {c!r}')
     >     if (t, os.path.normpath(c)) in vus:
     >         refus(f'entrée en double : {p!r}')
     >     vus.add((t, os.path.normpath(c)))
     >     if t != 'npm':
     >         print(f'{t} {c} : admis')
     >         continue
     >     r = os.path.join(src, c)
     >     if os.path.islink(r) or not os.path.isdir(r):
     >         refus(f'npm {c} : répertoire absent ou lien')
     >     for nom in ('npm-shrinkwrap.json', 'package-lock.json'):   # ordre d'Hermeto 0.64.0 (npm/resolver.py)
     >         v = os.path.join(r, nom)
     >         if os.path.lexists(v):
     >             break
     >     else:
     >         refus(f'npm {c} : aucun lockfile')
     >     if os.path.islink(v):
     >         refus(f'npm {c} : {nom} est un lien')
     >     try:
     >         l = json.load(open(v, encoding='utf-8'))
     >     except ValueError:
     >         refus(f'npm {c} : {nom} illisible')
     >     if l.get('lockfileVersion') not in (2, 3):
