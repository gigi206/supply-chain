## set -e après le « || » final de politique.sh:1677 ([ "${BASH_SOURCE[0]}" != "$0" ] || lancer politique J6 "$@"), essai-ou-final.sh
set -euo pipefail
etape() { echo avant; false; echo "après : set -e inopérant"; }
lancer() { { etape; } 2>&1 | sed -u 's/^/  /'; echo "lancer continue"; }
[ "${BASH_SOURCE[0]}" != "$0" ] || lancer
