set -euo pipefail
mode=$1 DISTRO=$2 src=$3
T=$ESSAI_T; W=$T; TSV_PARITE=$T/tsv; here=/nulle-part
mkdir -p "$T/adm" "$T/auth/docker"; : > "$T/auth/docker/config.json"
kubectl() { echo "kubectl $*" >> "$T/appels"; [ "${1:-}" != apply ] || cat > /dev/null; }
cli() { printf 'PASS\tmotif'; }
comparer() {
  case "$mode" in
    erreur) echo "admission : commande en échec sous set -e"; false ;;
    int) echo "INT au groupe"; kill -INT 0; sleep 1; echo "ne doit pas s'afficher" ;;
    term) echo "TERM au groupe"; kill -TERM 0; sleep 1; echo "ne doit pas s'afficher" ;;
    hup) echo "HUP au groupe"; kill -HUP 0; sleep 1; echo "ne doit pas s'afficher" ;;
    *) echo "OK   $1" ;;
  esac
}
case "$mode" in ko) printf 'cas-ko\tFAIL\tnon\tCLI seul\n' > "$T/adm/cas.tsv" ;; *) printf 'cas-1\tPASS\toui\t-\n' > "$T/adm/cas.tsv" ;; esac
trap 'rm -rf "$T/auth" "$W/refus.out"' EXIT
eval "etape_admission() {
local c e a desc r
$(sed -n '/^  RC_ESSAI=$/,/^  trap - INT TERM HUP$/p' "$src")
echo \"fin de l'étape\"
}"
c=0; { echo "# étape admission ($mode, $DISTRO)"; etape_admission; } 2>&1 | sed -u 's/^/  /' || c=$?
echo "  code de l'étape : $c"
