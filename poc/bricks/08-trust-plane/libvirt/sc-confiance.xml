<!-- Brique 08 : nœud de confiance (k3s server : Tekton, Chains, Triggers, OpenBao, Kyverno, TSA). 15 Go ; pas de démarrage automatique.
     Modèle Haswell-v4 (x86-64-v3 sans AVX-512, voir poc/infra) avec check='partial' : avec 'full',
     QEMU refuse les fonctions qu'il ajoute au modèle (constaté au banc A2). Graine cloud-init NoCloud
     en lecteur de CD-ROM (volume sc-confiance-graine.iso). Carte VGA sans affichage (ni VNC ni SPICE) : sans elle,
     le GRUB de l'image Debian 13 échoue avant « Loading Linux » et la VM redémarre en boucle (constaté le
     29/10/2026). -->
<domain type='kvm'>
  <name>sc-confiance</name>
  <memory unit='GiB'>8</memory>
  <vcpu placement='static'>4</vcpu>
  <os>
    <type arch='x86_64' machine='q35'>hvm</type>
    <boot dev='hd'/>
  </os>
  <features>
    <acpi/>
    <apic/>
  </features>
  <cpu mode='custom' match='exact' check='partial'>
    <model fallback='forbid'>Haswell-v4</model>
  </cpu>
  <clock offset='utc'/>
  <on_poweroff>destroy</on_poweroff>
  <on_reboot>restart</on_reboot>
  <on_crash>destroy</on_crash>
  <devices>
    <disk type='volume' device='disk'>
      <driver name='qemu' type='qcow2' discard='unmap'/>
      <source pool='supply-chain-poc' volume='sc-confiance.qcow2'/>
      <target dev='vda' bus='virtio'/>
    </disk>
    <disk type='volume' device='cdrom'>
      <driver name='qemu' type='raw'/>
      <source pool='supply-chain-poc' volume='sc-confiance-graine.iso'/>
      <target dev='sda' bus='sata'/>
      <readonly/>
    </disk>
    <interface type='network'>
      <source network='supply-chain-poc'/>
      <mac address='52:54:00:5c:08:11'/>
      <model type='virtio'/>
    </interface>
    <serial type='pty'>
      <target port='0'/>
    </serial>
    <console type='pty'>
      <target type='serial' port='0'/>
    </console>
    <rng model='virtio'>
      <backend model='random'>/dev/urandom</backend>
    </rng>
    <video>
      <model type='vga' heads='1' primary='yes'/>
    </video>
    <memballoon model='virtio'/>
  </devices>
</domain>
