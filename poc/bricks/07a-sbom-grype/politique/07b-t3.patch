+			Impact        string `json:"impact_statement"`
+			Timestamp     string `json:"timestamp"`
+			Vulnerability struct {
+				ID      string   `json:"@id"`
+				Name    string   `json:"name"`
+				Aliases []string `json:"aliases"`
+			} `json:"vulnerability"`
+			Products []struct {
+				ID            string `json:"@id"`
+				Subcomponents []struct {
