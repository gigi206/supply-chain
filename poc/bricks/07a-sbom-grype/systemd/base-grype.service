# Brique 07a, G1 (D3 a, décision du propriétaire du 04/11/2026) : archivage de la base Grype du jour dans Zot, sur sc-stockage.
# Seule sortie : grype.anchore.io (latest.json et archive) et Zot. Mot de passe de poc-vulndb :
# /etc/base-grype/secrets/poc-vulndb.password (root, 0600), remis au seul service par LoadCredential.
[Unit]
Description=Archivage de la base Grype du jour (brique 07a)
Wants=network-online.target
After=network-online.target zot.service

[Service]
Type=oneshot
User=base-grype
Group=base-grype
Environment=REG=192.168.161.13:5000
LoadCredential=zot:/etc/base-grype/secrets/poc-vulndb.password
ExecStart=/usr/local/lib/base-grype/base-grype.sh
TimeoutStartSec=30min
CacheDirectory=base-grype
CacheDirectoryMode=0750
RuntimeDirectory=base-grype
RuntimeDirectoryMode=0700
NoNewPrivileges=true
CapabilityBoundingSet=
AmbientCapabilities=
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
RestrictSUIDSGID=true
RestrictNamespaces=true
RestrictRealtime=true
LockPersonality=true
MemoryDenyWriteExecute=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
SystemCallArchitectures=native
UMask=0027
